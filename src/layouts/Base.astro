---
const { title = 'Dunn Creative' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <style is:global>
      :root { --bg:#0b0b0c; --fg:#f4f4f2; --muted:#a3a3a0; --line:#2c2c30; --teal:#1aa6aa; }
      * { box-sizing: border-box; }
      body { margin:0; background:var(--bg); color:var(--fg); font:16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
      main { max-width: 760px; margin: 0 auto; padding: 72px 20px; }
      a { color: var(--teal); }
      .eyebrow { font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--teal); }
      h1 { font-size: clamp(32px, 6vw, 52px); line-height: 1.1; margin: 8px 0 16px; }
      p { color: var(--muted); }
      ul { padding-left: 1.2em; }
      li { margin: 6px 0; }
    </style>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>
