---
// Layout for the pages Freeman picked on 24 Nov (Page Explorations v2). Styles: public/v2/v2.css,
// copied from the explorations. The other versions stay at /explore/pages/ for reference.
import V2Header from '../components/v2/V2Header.astro';
import V2Footer from '../components/v2/V2Footer.astro';
interface Props { title: string; description?: string }
const { title, description } = Astro.props;
// 'To come' chips (.held) show on Deploy Previews and /held, never on the live site (v04 · 10).
// Netlify sets CONTEXT=production for main; local builds and previews keep the chips visible.
const hideHeld = process.env.CONTEXT === 'production' && !Astro.url.pathname.startsWith('/held');
// On production the chips are also taken out of the HTML (not only hidden), so no "To come" text ships in dist/.
// Chips are plain-text spans; anything else stays as written.
let body = await Astro.slots.render('default');
if (hideHeld) body = body.replace(/<span class="held"[^>]*>[^<]*<\/span>/g, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!-- Type option 1 (v04 · 1): self-hosted, see public/fonts/ and the @font-face rules in public/v2/v2.css. -->
    <link rel="preload" href="/fonts/inter-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/v2/v2.css" />
    {hideHeld && <style is:inline set:html=".held{display:none!important}" />}
  </head>
  <body>
    <V2Header />
    <main><Fragment set:html={body} /></main>
    <V2Footer />
  </body>
</html>
