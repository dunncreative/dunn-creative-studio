---
// Service detail template, per wireframe service-detail_v02 (shown there: Websites; 7 bands, 1 dark).
// One page per service in src/data/services.ts. Only Websites was wireframed with its own copy;
// the others carry the hub's lines and tags, and their process stays held until Freeman checks it.
import { getCollection, type CollectionEntry } from 'astro:content';
import Work from '../../layouts/Work.astro';
import WorkCard from '../../components/WorkCard.astro';
import Held from '../../components/Held.astro';
import Faq from '../../components/Faq.astro';
import CtaBox from '../../components/CtaBox.astro';
import { details, type ServiceDetail } from '../../data/services';
import { TALK } from '../../lib/site';

export function getStaticPaths() {
  return details.map((s) => ({ params: { service: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: ServiceDetail };

const all = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
let work: CollectionEntry<'work'>[];
if (s.work.length) {
  work = s.work.map((id) => all.find((e) => e.id === id)).filter((e): e is CollectionEntry<'work'> => Boolean(e));
} else if (s.workHeld) {
  work = [];
} else {
  // Brand identity and Campaigns: everything tagged for that service page in the Work collection.
  work = all.filter((e) => (e.data.serviceTags as string[]).includes(s.slug)).slice(0, 6);
}
---
<Work title={`${s.name} · Services · Dunn Creative`} description={s.sub}>
  <!-- 01 · Hero + spec row -->
  <section class="band">
    <div class="wrap">
      <p class="eyebrow"><a href="/services/">Services</a> · {s.name}</p>
      <h1>{s.headline}</h1>
      <p class="lede">{s.sub}</p>
      <div class="actions"><a class="textcta" href="#work">See the work +</a></div>
      <dl class="specrow spec">
        <div><dt>Timeline</dt><dd><Held id="timelines" note="typical range" /></dd></div>
        <div><dt>Deliverables</dt><dd>{s.deliverables}</dd></div>
        {s.slug === 'websites' && <div><dt>Formats</dt><dd><Held id="platforms" /></dd></div>}
      </dl>
    </div>
  </section>

  <!-- 02 · What you get -->
  <section class="band grey">
    <div class="wrap">
      <div class="sec-head"><h2>What you get</h2></div>
      <ul class="checks">
        {s.get.map((g) => <li><span class="box" aria-hidden="true"></span><span>{g.item} {g.held && <Held id={g.held} />}</span></li>)}
      </ul>
      {s.copyHeld && <Held id="service-copy" block />}
    </div>
  </section>

  <!-- 03 · Work -->
  <section class="band" id="work">
    <div class="wrap">
      <div class="sec-head"><h2>{s.workTitle}</h2></div>
      {work.length > 0 ? (
        <div class="grid">{work.map((e) => <WorkCard entry={e} large={e.data.kind === 'case-study'} />)}</div>
      ) : (
        s.workHeld && <Held id={s.workHeld} block />
      )}
      <div class="actions"><a class="textcta" href="/work/">All work +</a></div>
    </div>
  </section>

  <!-- 04 · How AI helps here -->
  <section class="band grey">
    <div class="wrap">
      <div class="sec-head"><h2>How AI helps here</h2></div>
      <div class="cards">
        {s.ai.map((a) => (
          <article class="card-s"><p class="label">{a.k}</p><p class="big">{a.v}</p></article>
        ))}
      </div>
      <div class="actions"><a class="textcta" href="/ai/">How we use AI +</a></div>
    </div>
  </section>

  <!-- 05 · Process -->
  <section class="band">
    <div class="wrap">
      <div class="sec-head"><h2>How it runs</h2></div>
      {s.process ? (
        <><ol class="steps">
          {s.process.map((p) => <li><span class="n">{p.n}</span><h3>{p.t}</h3><p>{p.d}</p></li>)}
        </ol>
        {s.copyHeld && <Held id="draft-copy" block note="process steps: proposed titles, placeholder copy" />}</>
      ) : (
        <Held id="service-copy" block note="process steps for this service" />
      )}
    </div>
  </section>

  <!-- 06 · FAQ -->
  <Faq>
    {s.faq.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a ?? (f.held && <Held id={f.held} />)}</p></details>
    ))}
  </Faq>

  <!-- 07 · CTA -->
  <CtaBox title={s.cta} button="Let's talk" href={TALK} />
</Work>

<style>
  h1 { max-width: 18ch; }
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { text-decoration: underline; }
  .spec { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--grey-200); }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 48px; max-width: 900px; }
  @media (min-width: 720px) { .checks { grid-template-columns: 1fr 1fr; } }
  .checks li { display: flex; gap: 14px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--grey-200); color: var(--ink); margin: 0; }
  .box { flex: none; width: 14px; height: 14px; border: 1.5px solid var(--ink); border-radius: 3px; transform: translateY(1px); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px 20px; }
  @media (min-width: 720px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1040px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .big { font-size: var(--fs-card); font-weight: 600; line-height: 1.3; color: var(--ink); }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; counter-reset: none; }
  @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1040px) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .steps li { margin: 0; border-top: 1.5px solid var(--ink); padding-top: 16px; }
  .steps .n { font-weight: 600; color: var(--caption); }
  .steps h3 { margin: 6px 0 6px; }
  .steps p { margin: 0; }
</style>
