---
// Area pages on the Direction A template (v04 · 12, Freeman's 27 Nov picks): Brand Identity (brand-identity-offer-v2),
// Web & Digital (web-digital-v2), Marketing Creative (marketing-creative-v2), AI Creative (ai-creative-v2) and
// AI for Teams (ai-for-teams-v2). One template for all five: hero → What we offer → selected work → (AI for Teams:
// how the pipeline works) → How to buy it → Often paired with → closing CTA. Copy: src/data/areas.ts.
//
// Film & Motion is not in the 27 Nov picks; it keeps its live page (src/pages/services/film-motion.astro).
// The 24 Nov layouts these routes used (src/v2/branding.html, web-digital.html, marketing.html) stay in the repo
// until Freeman confirms they can go. Retired service URLs keep their redirects in netlify.toml.
import A from '../../layouts/A.astro';
import AHero from '../../components/a/AHero.astro';
import ASection from '../../components/a/ASection.astro';
import OfferGrid from '../../components/a/OfferGrid.astro';
import FeatureWork from '../../components/a/FeatureWork.astro';
import Steps from '../../components/a/Steps.astro';
import BuyPanel from '../../components/a/BuyPanel.astro';
import NumberedRows from '../../components/a/NumberedRows.astro';
import CtaPanel from '../../components/a/CtaPanel.astro';
import { areas, area, areaNumber, type Area } from '../../data/areas';

export function getStaticPaths() {
  return areas.filter((a) => a.page).map((a) => ({ params: { service: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: Area };
const p = a.page!;
const next = area(p.next);
const paired = p.paired.map((s) => { const x = area(s); return { n: areaNumber(s), name: x.name, line: x.line, href: x.href }; });
---
<A title={`${a.name} · Services · Dunn Creative`} description={p.description}>
  <AHero hero={p.hero}>
    <div class="a-hero__after"><a href="/services/">← All services</a><span>Next: <a class="is-strong" href={next.href}>{next.name}</a></span></div>
  </AHero>
  <ASection title="What we *offer*" lead={p.offersLead} side={p.offersSide}>
    <OfferGrid offers={p.offers} />
  </ASection>
  {p.feature && <FeatureWork feature={p.feature} />}
  {p.extra && (
    <ASection eyebrow={p.extra.eyebrow} title={p.extra.title} side={p.extra.side} space="tight">
      <Steps steps={p.extra.steps} tone="light" />
    </ASection>
  )}
  <BuyPanel panel={p.buy} id="buy" />
  <ASection eyebrow="Often paired with" space="tight">
    <NumberedRows items={paired} />
  </ASection>
  <CtaPanel cta={p.cta} />
</A>
