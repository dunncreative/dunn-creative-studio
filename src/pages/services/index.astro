---
// Services hub, per wireframe services_v02-1 (Site Blueprint "Services", 8 bands, 2 dark).
// Groups and rows live in src/data/services.ts. Rows link to a detail page, to /ai,
// or say "No detail page yet" (Marketing strategy, Photo direction).
import Work from '../../layouts/Work.astro';
import Held from '../../components/Held.astro';
import Faq from '../../components/Faq.astro';
import CtaBox from '../../components/CtaBox.astro';
import { groups } from '../../data/services';
import { AUDIT } from '../../lib/site';
const href = (to: string | null) => (to === null ? null : to === '/ai' ? '/ai/' : `/services/${to}/`);
---
<Work title="Services · Dunn Creative" description="Brand identity, websites, campaigns, print, decks and AI services from Dunn Creative, a senior-led studio in Jackson, WY.">
  <!-- 01 · Hero -->
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1>Everything a brand needs to show up well.</h1>
      <p class="lede">Most clients start with one thing and stay for the system. Pick the starting point that fits, and we'll connect the rest.</p>
      <nav class="jump" aria-label="Jump to a group">
        <span class="label">Jump to:</span>
        {groups.map((g) => <a href={`#${g.id}`}>{g.name} +</a>)}
      </nav>
    </div>
  </section>

  <!-- 02 to 06 · Groups -->
  {groups.map((g) => (
    <section class:list={['band', g.tone]} id={g.id}>
      <div class="wrap">
        <div class="sec-head"><h2>{g.name}</h2></div>
        <div class:list={['cards', { four: g.rows.length === 4 }]}>
          {g.rows.map((r) => (
            <article class="card-s">
              <h3>{r.name}</h3>
              {r.line && <p>{r.line}</p>}
              {r.tags.length > 0 && <ul class="chips">{r.tags.map((t) => <li>{t}</li>)}</ul>}
              {r.held && <p><Held id={r.held} /></p>}
              {href(r.to)
                ? <a class="textcta more" href={href(r.to)!}>Learn more +</a>
                : <span class="more note">No detail page yet</span>}
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- 07 · FAQ -->
  <Faq>
    <details><summary>How does AI fit in?</summary><p>We use it for drafts, variations and production. Every asset gets human direction, curation and final polish, and we'll always tell you what's AI-assisted.</p></details>
    <details><summary>Do you work with existing brands?</summary><p>Yes. Refreshes, extensions and ongoing support are common starting points.</p></details>
    <details><summary>What does it cost?</summary><p>It depends on scope. You'll get a fixed quote after a short call.</p></details>
    <details><summary>How many revisions?</summary><p><Held id="revisions" note="revision rounds (draft: two to three on most projects)" /></p></details>
    <details><summary>Can you work with our media buyer or agency?</summary><p>Yes. We deliver in the specs and naming they need.</p></details>
  </Faq>

  <!-- 08 · CTA -->
  <CtaBox title="Start with an audit." button="Get an audit" href={AUDIT}>
    <p>Not sure what you need? A senior review of your brand, site or workflow, with a prioritized plan. <Held id="audit-format" /></p>
  </CtaBox>
</Work>

<style>
  h1 { max-width: 16ch; }
  .jump { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 32px; }
  .jump .label { margin-right: 4px; }
  .jump a { padding: 8px 16px; border-radius: 999px; border: 1px solid var(--grey-200); color: var(--ink); text-decoration: none; font-size: 15px; }
  .jump a:hover { border-color: var(--ink); }
  .band[id] { scroll-margin-top: 16px; }
  .band.dark .card-s h3 { color: #fff; }
</style>
