---
// About, per wireframe about_v02-1 (Site Blueprint "About", 5 bands, 1 dark), in the Ridge look.
import { Image } from 'astro:assets';
import Work from '../layouts/Work.astro';
import Held from '../components/Held.astro';
import MediaSlot from '../components/MediaSlot.astro';
import RidgeHero from '../components/RidgeHero.astro';
import RidgeCta from '../components/RidgeCta.astro';
import Texture from '../components/Texture.astro';
import portrait from '../assets/studio/chris-dunn-portrait-bw.webp';
import { TALK } from '../lib/site';

const credits = [
  ['Teton Gravity Research', 'Senior creative roles'],
  ['Brain Farm', 'Long-running creative work'],
  ['We Are Blood', 'Film campaign'],
  ['The Fourth Phase', 'Film campaign'],
  ['View From A Blue Moon', 'Film campaign'],
];
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<Work title="About · Dunn Creative" description="Chris Dunn directs every Dunn Creative project: 20+ years across creative direction, brand, web and content, based in Jackson, WY.">
  <!-- 01 · Hero -->
  <RidgeHero short label="About" title="I’m Chris Dunn. I direct every project here." stand="I’ve spent 20+ years across creative direction, brand, web and content, most of it in action sports, film and lifestyle, where the work has to look as good as the footage. Dunn Creative pairs that with an AI-accelerated workflow, so your budget goes to thinking and craft." meta={['Creative director', 'Jackson, WY']}>
    <div class="ctas">
      <a class="btn" href={TALK}>Let's talk</a>
      <a class="textcta" href="/work/">See the work +</a>
    </div>
  </RidgeHero>

  <!-- Founder -->
  <section class="band">
    <div class="wrap split">
      <figure class="portrait">
        <Image src={portrait} alt="Chris Dunn, black-and-white portrait" widths={[480, 800]} sizes="(min-width: 880px) 480px, 100vw" />
      </figure>
      <div>
        <p class="lbl">Founder</p>
        <p class="bigline" style="margin:14px 0 26px">One senior creative director directs every job, from the first idea to the final file.</p>
        <p class="stand">Senior creative roles at Teton Gravity Research; film campaign credits on We Are Blood, The Fourth Phase and View From A Blue Moon.</p>
      </div>
    </div>
  </section>

  <!-- 02 · Credits -->
  <section class="band grey">
    <div class="wrap">
      <div class="sechead"><h2>Credits</h2></div>
      <div class="index">
        {credits.map(([name, role], i) => <div class="row"><span class="n">{n(i)}</span><h3>{name}</h3><p>{role}</p><div></div></div>)}
      </div>
    </div>
  </section>

  <!-- 03 · How the studio works (the page's one dark band after the hero) -->
  <section class="band dark">
    <Texture />
    <div class="wrap">
      <div class="sechead"><h2>How the studio works</h2></div>
      <div class="three">
        <div><p class="lbl">01</p><h3>Lean senior core</h3><p>Chris directs every project, start to finish.</p></div>
        <div><p class="lbl">02</p><h3>Network</h3><p>Specialists brought in by the job. <Held id="network" /></p></div>
        <div><p class="lbl">03</p><h3>Agent studio</h3><p>AI seats draft, version and prep. People approve every gate.</p><a class="textcta" href="/ai/" style="display:inline-block;margin-top:14px">How we use AI +</a></div>
      </div>
    </div>
  </section>

  <!-- 04 · Jackson, WY -->
  <section class="band">
    <div class="wrap split">
      <div><p class="lbl">Jackson, WY</p><h2 style="margin-top:12px">Based in Jackson. Working everywhere.</h2></div>
      <div>
        <p class="stand">The mountains keep the work honest: simple, durable and built for real conditions. Clients are local, national and remote.</p>
        <div class="photos">
          <MediaSlot label="Chris fly fishing on the Green River" file="Chris-Dunn-Fly-Fishing-on-Green-River-Wyoming.jpg" ratio="4 / 5" held="about-photos" />
          <MediaSlot label="Chris backcountry snowboarding, Grand Teton National Park" file="Chris-Dunn-Backcountry-Snowboard-Grand-Teton-National-Park.jpg" ratio="4 / 5" held="about-photos" />
        </div>
      </div>
    </div>
  </section>

  <!-- 05 · CTA -->
  <RidgeCta title="Have a project in mind?" button="Let's talk" href={TALK}>
    <p class="stand">Tell us what you're building.</p>
    <Held id="response-time" />
  </RidgeCta>
</Work>
<style>
  .photos { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 32px; }
</style>
