---
// Sprints (v04 · 12): Freeman's 27 Nov pick, A · Sprints v2 (public/explore/design-a/sprints-v2.html, galaxy image 1),
// on the Direction A template. Copy: src/data/sprints.ts. No prices (held: sprint-prices).
// Kept from the live page: the FAQ answers (real copy). Not carried over: the live page's tabs for the other three
// sprint plans and its start form; the sprint buttons now go to /contact/ (Brand Sprint to its own page).
// The 24 Nov markup (src/v2/sprints.html) stays in the repo until Freeman confirms it can go.
import A from '../layouts/A.astro';
import AHero from '../components/a/AHero.astro';
import ASection from '../components/a/ASection.astro';
import SprintCards from '../components/a/SprintCards.astro';
import BuyPanel from '../components/a/BuyPanel.astro';
import Steps from '../components/a/Steps.astro';
import Faq from '../components/a/Faq.astro';
import CtaPanel from '../components/a/CtaPanel.astro';
import { sprints, sprintsHero, brandSprintDays, owned, sprintsFaq, sprintsCta, BRAND_SPRINT } from '../data/sprints';
import { nn } from '../lib/rich';
---
<A title="Sprints · Dunn Creative" description="Fixed-scope sprints from Dunn Creative: a free Audit, a Brand Sprint, a Web Sprint, a Launch Film, an AI Workflow Sprint and a monthly Creative Retainer, each with a day-by-day plan.">
  <AHero hero={sprintsHero} />
  <section class="a-wrap a-sec is-tight" id="sprints" aria-label="The sprints">
    <p style="margin-bottom:20px"><span class="held">To come: sprint lengths and terms</span></p>
    <SprintCards items={sprints.map((s, i) => ({ s, n: nn(i + 1) }))} firstGrey />
  </section>
  <BuyPanel panel={{ eyebrow: 'How a Brand Sprint runs', title: 'Counted in days, decided on calls.', steps: brandSprintDays, ctas: [{ label: 'See the Brand Sprint', href: BRAND_SPRINT, style: 'teal' }] }} />
  <ASection title="Everything is *yours.*" size="md" space="tight">
    <Steps steps={owned} tone="plain" />
  </ASection>
  <ASection title="Straight *answers.*" eyebrow="FAQ" size="md" space="tight">
    <Faq items={sprintsFaq} />
  </ASection>
  <CtaPanel cta={sprintsCta} id="start" />
</A>
