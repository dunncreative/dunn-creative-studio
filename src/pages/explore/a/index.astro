---
// Exploration A · White Room (lead board, Moodboard v02) · Task #33
// One-page lead site. Light-first; two Ink "Summit Line" bands (AI, final CTA) carry the
// official White symbol texture. Copy: Website Copy v02 only, every [held]/[confirm] line left out.
// The form is an exploration: it never submits anywhere.
import { Image } from 'astro:assets';
import logoBlack from '../../../assets/studio/dunn-creative-logo-black.svg';
import texture from '../../../assets/studio/dc-symbol-white-tile.webp';
import hero from '../../../assets/studio/hero-mountain-ai-bw.webp';
import portrait from '../../../assets/studio/chris-dunn-portrait-bw.webp';
import deeper from '../../../assets/work/jeremy-jones-deeper/deeper-poster.webp';
import gu from '../../../assets/work/gu-energy/gu-brochure-outside.webp';
import ironwood from '../../../assets/work/ironwood-homes/ironwood-logo-stacked.webp';

const nav = [
  { label: 'Work', href: '#work' },
  { label: 'Services', href: '#services' },
  { label: 'AI', href: '#ai' },
  { label: 'Process', href: '#process' },
  { label: 'About', href: '#about' },
];

// Logo permissions are held (copy v02), so names are set as text.
const clients = ['Teton Gravity Research', 'Brain Farm', 'GU Energy', 'Stio', 'Peace Park', 'Asymbol', 'Ironwood Homes'];

const work = [
  {
    img: deeper, alt: "Jeremy Jones' Deeper film poster: the deeper title over a snow-fluted mountain face",
    title: "Jeremy Jones' Deeper", meta: 'Teton Gravity Research · Packaging, print, film marketing',
    line: "Packaging, poster, magazine ads and DVD menu for the first film in TGR's Deeper, Further, Higher trilogy with Jeremy Jones.",
  },
  {
    img: gu, alt: 'GU Energy product brochure, outside spread, with the GU nutrition matrix panel',
    title: 'GU Energy', meta: 'Print and digital design',
    line: "Overflow design partner for GU Energy's in-house team: magazine ads, digital promos, a ride nutrition plan card and a product brochure.",
  },
  {
    img: ironwood, alt: 'Ironwood Homes stacked logo in black on white',
    title: 'Ironwood Homes', meta: 'Brand · Web',
    line: 'Brand and web for a custom home builder in Star Valley, WY.',
  },
];

const services = [
  { name: 'Brand Identity', tags: ['Strategy', 'Logo suite', 'Guidelines'], line: 'Strategy, naming, logo, type, color and the guidelines that hold it together.' },
  { name: 'Websites', tags: ['Strategy', 'Design', 'Build'], line: 'Marketing sites, landing pages and stores, designed and built to convert.' },
  { name: 'Campaigns & Content', tags: ['Ads', 'Social', 'Email'], line: 'Ads, social, email, motion and video, with variations built for testing.' },
  { name: 'Presentations & Decks', tags: ['Pitch', 'Sales', 'Reports'], line: 'Investor, sales and partnership decks that get read to the end.' },
  { name: 'Motion & Video', tags: ['Motion', 'Video', 'Photo direction'], line: 'Motion and video that bring the brand system to life without breaking it.' },
  { name: 'Marketing Strategy', tags: ['Positioning', 'Messaging', 'Concepts'], line: 'Positioning and messaging that give every creative decision a reason.' },
];

const ai = [
  { name: 'Senior-Led AI Production', line: 'Senior creative direction with AI in the production line.' },
  { name: 'AI Consulting', line: "AI built into how your team creates, with the judgment to know where it helps and where it doesn't." },
  { name: 'Agent studio', line: "The studio's own AI seats plan, draft and check the work, and a person approves every step." },
];

const steps = [
  { name: 'Brief' },
  { name: 'Studio lead' },
  { name: 'Seats', sub: ['Brand', 'Copy', 'Design', 'Build', 'QA'] },
  { name: 'Chris approves', gate: true },
  { name: 'Delivered' },
];

const engage = [
  { name: 'Audit', line: 'A senior review of your brand, site or creative workflow, with a prioritized plan you can act on.' },
  { name: 'Sprint', line: 'A defined project with a clear finish line.' },
  { name: 'Retainer', line: 'Monthly creative capacity for teams that ship constantly: ads, social, email, decks and web updates.' },
];

const needs = ['Website', 'Branding', 'Content', 'AI', 'Free Audit', 'Not sure'];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Exploration A · White Room · Dunn Creative</title>
  <meta name="description" content="Dunn Creative is a senior-led creative studio in Jackson, WY. Brand, web and content, built sharper and shipped faster, with AI in the workflow." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body style={`--texture:url(${texture.src})`}>
  <a class="skip" href="#main">Skip to content</a>

  <!-- 00 · Nav -->
  <header class="nav">
    <div class="wrap nav__row">
      <a class="nav__logo" href="#top" aria-label="Dunn Creative, top of page">
        <img src={logoBlack.src} alt="Dunn Creative" width="120" height="57" />
      </a>
      <nav class="nav__links" aria-label="Main">
        {nav.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="nav__end">
        <a class="pill-outline" href="#contact">Let's talk</a>
        <details class="nav__menu">
          <summary aria-label="Menu"><span></span><span></span></summary>
          <div class="nav__panel">
            {nav.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        </details>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- 01 · Hero (White) -->
    <section class="hero" id="top">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="eyebrow" data-reveal>Creative studio · Jackson, WY</p>
          <h1 class="display" data-reveal>Brand, web and content. Built sharper, shipped faster.</h1>
          <div class="hero__foot">
            <p class="lede" data-reveal>Dunn Creative is a senior-led studio with an AI-accelerated workflow. You get 20+ years of brand and digital judgment, with production that keeps up with your calendar.</p>
            <div class="hero__ctas" data-reveal>
              <a class="btn" href="#contact">Let's talk</a>
              <a class="tcta" href="#work">See the work <span aria-hidden="true">+</span></a>
            </div>
          </div>
        </div>
        <figure class="hero__media">
          <div class="hero__frame">
            <Image src={hero} alt="Black and white mountain peaks with cloud drifting across the ridgeline" widths={[800, 1200, 1672]} sizes="(max-width: 759px) 100vw, min(1440px, 100vw)" loading="eager" fetchpriority="high" class="hero__img" />
          </div>
          <figcaption class="ai-label">AI-made image</figcaption>
        </figure>
      </div>
    </section>

    <!-- 02 · Client names (Grey 50) -->
    <section class="band band--grey names" aria-labelledby="names-h">
      <div class="wrap names__row">
        <p class="eyebrow" id="names-h">Brands we've built work for</p>
        <ul class="names__list">
          {clients.map((c) => <li data-reveal>{c}</li>)}
        </ul>
      </div>
    </section>

    <!-- 03 · Founder / who (White) -->
    <section class="band about" id="about" aria-labelledby="about-h">
      <div class="wrap about__grid">
        <figure class="about__portrait" data-reveal>
          <Image src={portrait} alt="Chris Dunn, black and white portrait" widths={[480, 800, 1024]} sizes="(max-width: 759px) 100vw, 40vw" />
        </figure>
        <div class="about__copy">
          <p class="eyebrow" data-reveal>Founder</p>
          <h2 class="section" id="about-h" data-reveal>Every project, directed by Chris.</h2>
          <p class="body" data-reveal>Chris Dunn has spent 20+ years in creative direction, brand, web and content, most of it in action sports, film and lifestyle, where the work has to look as good as the footage. He was Creative Director at Teton Gravity Research, and he ran digital marketing for films including We Are Blood and View From A Blue Moon, on behalf of Brain Farm. He runs Dunn Creative and directs every project himself.</p>
        </div>
      </div>
    </section>

    <!-- 04 · Selected work (Grey 50) -->
    <section class="band band--grey" id="work" aria-labelledby="work-h">
      <div class="wrap">
        <header class="band__head">
          <p class="eyebrow" data-reveal>Selected work</p>
          <h2 class="section" id="work-h" data-reveal>Recent work.</h2>
        </header>
        <div class="work">
          {work.map((w, i) => (
            <article class:list={['tile', 'tile--white', 'work__tile', `work__tile--${i}`]} data-reveal>
              <div class="work__media">
                <Image src={w.img} alt={w.alt} widths={[480, 800, 1200]} sizes={i === 0 ? '(max-width: 759px) 100vw, 58vw' : '(max-width: 759px) 100vw, 40vw'} />
              </div>
              <div class="work__body">
                <p class="label">Case study</p>
                <h3 class="card">{w.title}</h3>
                <p class="meta">{w.meta}</p>
                <p class="body">{w.line}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 05 · Services (White) -->
    <section class="band" id="services" aria-labelledby="services-h">
      <div class="wrap">
        <header class="band__head">
          <p class="eyebrow" data-reveal>Services</p>
          <h2 class="section" id="services-h" data-reveal>Six things, done properly.</h2>
        </header>
        <ul class="services">
          {services.map((s, i) => (
            <li class="tile tile--grey svc" data-reveal>
              <span class="svc__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="card">{s.name}</h3>
              <p class="svc__tags">{s.tags.join(' · ')}</p>
              <p class="body">{s.line}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 06 · AI band (Ink + texture) -->
    <section class="band band--dark" id="ai" aria-labelledby="ai-h">
      <div class="texture" aria-hidden="true"></div>
      <div class="wrap ai">
        <div class="ai__intro">
          <p class="eyebrow" data-reveal>Creative studio · AI studio</p>
          <h2 class="section" id="ai-h" data-reveal>Two studios under one roof.</h2>
          <p class="body" data-reveal>The creative studio makes the work: brands, sites, campaigns and decks. The AI studio builds the agent seats and workflows that help make it. Chris approves the work at every step.</p>
          <a class="tcta tcta--dark" href="#contact" data-need="AI" data-reveal>Let's talk <span aria-hidden="true">+</span></a>
        </div>
        <ul class="ai__rows">
          {ai.map((r) => (
            <li data-reveal>
              <h3 class="card">{r.name}</h3>
              <p class="body">{r.line}</p>
            </li>
          ))}
        </ul>
        <div class="ai__stance" data-reveal>
          <h3 class="card">Directed, not generated.</h3>
          <p class="body">AI drafts, versions and preps. People make the strategy, the direction and the final calls. Client data is never used for training. Client imagery runs on commercially safe models. No AI renders your type. And we always tell you what's AI-assisted.</p>
        </div>
      </div>
    </section>

    <!-- 07 · Process (White) -->
    <section class="band" id="process" aria-labelledby="process-h">
      <div class="wrap">
        <header class="band__head band__head--split">
          <div>
            <p class="eyebrow" data-reveal>Process</p>
            <h2 class="section" id="process-h" data-reveal>How it runs.</h2>
          </div>
          <p class="body" data-reveal>A studio lead agent plans each job and hands the pieces to specialist seats. Each seat drafts, checks or builds one part. Every handoff passes a gate, and a person approves at every gate. Nothing ships without Chris signing off.</p>
        </header>
        <ol class="flow" data-flow>
          {steps.map((s, i) => (
            <li class:list={['flow__step', { 'flow__step--gate': s.gate }]} data-reveal>
              <span class="flow__dot" aria-hidden="true"></span>
              <span class="flow__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="card">{s.name}</h3>
              {s.sub && <p class="flow__sub">{s.sub.join(' · ')}</p>}
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 08 · How we engage (Grey 50) -->
    <section class="band band--grey" aria-labelledby="engage-h">
      <div class="wrap">
        <header class="band__head">
          <p class="eyebrow" data-reveal>How we engage</p>
          <h2 class="section" id="engage-h" data-reveal>Start small. Scale when it works.</h2>
        </header>
        <ol class="engage">
          {engage.map((e, i) => (
            <li class="tile tile--white engage__card" data-reveal>
              <span class="engage__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="card">{e.name}</h3>
              <p class="body">{e.line}</p>
            </li>
          ))}
        </ol>
        <a class="tcta" href="#contact" data-need="Free Audit" data-reveal>Let's talk <span aria-hidden="true">+</span></a>
      </div>
    </section>

    <!-- 09 · Final CTA + lead form (Ink + texture) -->
    <section class="band band--dark" id="contact" aria-labelledby="contact-h">
      <div class="texture" aria-hidden="true"></div>
      <div class="wrap contact">
        <div class="contact__intro">
          <h2 class="section" id="contact-h" data-reveal>Ready to build something sharper?</h2>
          <p class="body" data-reveal>Tell us what you're building.</p>
          <p class="contact__direct" data-reveal>chris@dunncreative.com · Jackson, WY</p>
        </div>

        <form class="form tile tile--white" action="#" method="post" novalidate data-form data-reveal>
          <fieldset class="seg">
            <legend class="flabel">How would you like to start?</legend>
            <label><input type="radio" name="start" value="brief" checked /> <span>Get started</span></label>
            <label><input type="radio" name="start" value="call" /> <span>Schedule a 30-minute call</span></label>
          </fieldset>

          <div class="form__row">
            <div class="field">
              <label class="flabel" for="f-name">Name</label>
              <input id="f-name" name="name" type="text" autocomplete="name" placeholder="First and last" required aria-describedby="e-name" />
              <p class="ferr" id="e-name" hidden>Add your name so we know who to reply to.</p>
            </div>
            <div class="field">
              <label class="flabel" for="f-email">Email</label>
              <input id="f-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required aria-describedby="e-email" />
              <p class="ferr" id="e-email" hidden>Add a valid email so we can reply.</p>
            </div>
          </div>

          <div class="field">
            <label class="flabel" for="f-company">Company or brand</label>
            <input id="f-company" name="company" type="text" autocomplete="organization" placeholder="Name, or what it'll be called" />
          </div>

          <fieldset class="chips">
            <legend class="flabel">What do you need?</legend>
            {needs.map((n) => (
              <label class="chip"><input type="checkbox" name="need" value={n} /> <span>{n}</span></label>
            ))}
          </fieldset>

          <div class="field">
            <label class="flabel" for="f-msg">Message</label>
            <textarea id="f-msg" name="message" rows="4" placeholder="What you're working on, what's not working, and any key dates."></textarea>
          </div>

          <div class="form__end">
            <button class="btn" type="submit" data-submit>Send inquiry</button>
            <p class="form__note">Exploration — form not live. Nothing is sent.</p>
          </div>
          <p class="form__status" role="status" aria-live="polite" data-status></p>
        </form>
      </div>
    </section>
  </main>

  <!-- 10 · Footer (Grey 50) -->
  <footer class="band band--grey foot">
    <div class="wrap foot__grid">
      <div>
        <img src={logoBlack.src} alt="Dunn Creative" width="140" height="67" class="foot__logo" />
        <p class="body">Strategic thinking. Clean design. Real results.</p>
      </div>
      <nav class="foot__nav" aria-label="Footer">
        {nav.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="#contact">Contact</a>
      </nav>
      <div class="foot__meta">
        <p class="body">Jackson, WY · <a href="mailto:chris@dunncreative.com">chris@dunncreative.com</a></p>
        <p class="body">© {year} Dunn Creative</p>
        <p class="body foot__x">Exploration A · White Room. Preview only, not indexed.</p>
      </div>
    </div>
  </footer>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Hero push-in: starts once the image has loaded; off under reduced motion (CSS shows the final frame).
    const heroImg = document.querySelector<HTMLImageElement>('.hero__img');
    if (heroImg) {
      const go = () => document.documentElement.classList.add('hero-ready');
      if (heroImg.complete) go(); else heroImg.addEventListener('load', go, { once: true });
    }

    // Reveal: 8px rise + fade, 600ms, staggered 60ms within each group, once per element.
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    if (!reduce.matches && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('motion');
      const io = new IntersectionObserver((entries) => {
        const shown = entries.filter((e) => e.isIntersecting);
        shown.forEach((e, i) => {
          const el = e.target as HTMLElement;
          el.style.transitionDelay = `${Math.min(i, 8) * 60}ms`;
          el.classList.add('in');
          io.unobserve(el);
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
      els.forEach((el) => io.observe(el));
      const flow = document.querySelector('[data-flow]');
      if (flow) new IntersectionObserver((en, o) => { if (en[0].isIntersecting) { flow.classList.add('drawn'); o.disconnect(); } }, { threshold: 0.4 }).observe(flow);
    } else {
      document.querySelector('[data-flow]')?.classList.add('drawn');
    }

    // Close the mobile menu after picking a link.
    document.querySelectorAll('.nav__panel a').forEach((a) => a.addEventListener('click', () => {
      a.closest('details')?.removeAttribute('open');
    }));

    // Form: exploration only. Never submits; validates in place and says so.
    const form = document.querySelector<HTMLFormElement>('[data-form]');
    if (form) {
      const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
      const status = form.querySelector<HTMLElement>('[data-status]')!;
      const setMode = () => {
        const call = (form.elements.namedItem('start') as RadioNodeList).value === 'call';
        submit.textContent = call ? 'Request a call' : 'Send inquiry';
      };
      form.addEventListener('change', setMode);

      // Links elsewhere on the page can preselect a need (e.g. Free Audit, AI).
      document.querySelectorAll<HTMLElement>('[data-need]').forEach((a) => a.addEventListener('click', () => {
        const box = form.querySelector<HTMLInputElement>(`input[name="need"][value="${a.dataset.need}"]`);
        if (box) box.checked = true;
      }));

      const check = (input: HTMLInputElement, err: HTMLElement, ok: boolean) => {
        err.hidden = ok;
        input.setAttribute('aria-invalid', ok ? 'false' : 'true');
        return ok;
      };
      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const name = form.querySelector<HTMLInputElement>('#f-name')!;
        const email = form.querySelector<HTMLInputElement>('#f-email')!;
        const okName = check(name, form.querySelector('#e-name')!, name.value.trim().length > 0);
        const okEmail = check(email, form.querySelector('#e-email')!, /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim()));
        if (!okName) { name.focus(); status.textContent = ''; return; }
        if (!okEmail) { email.focus(); status.textContent = ''; return; }
        status.textContent = 'Form not live in this exploration. Nothing was sent.';
      });
    }
  </script>
</body>
</html>

<style is:global>
  :root {
    --white: #FFFFFF; --grey-50: #F5F5F7; --grey-200: #E3E3E6;
    --grey-500: #8A8D91; /* captions on dark only */
    --dark-grey: #333333; /* body + captions on light */
    --ink: #0B0C0D; --teal: #1AA6AA; --teal-deep: #10777A;
    --font: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --fs-display: clamp(44px, 5.6vw, 80px);
    --fs-section: clamp(28px, 3.1vw, 44px);
    --fs-card: clamp(20px, 1.55vw, 22px);
    --fs-body: 17px;
    --r-tile: 22px; --r-pill: 999px;
    --pad-band: clamp(64px, 9vw, 128px);
    --gutter: clamp(16px, 4vw, 48px);
    --max: 1200px;
    --ease: cubic-bezier(.2, .7, .2, 1);
    --texture-opacity: .07;
    --nav-h: 72px;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: calc(var(--nav-h) + 8px); }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0; background: var(--white); color: var(--dark-grey);
    font-family: var(--font); font-size: var(--fs-body); line-height: 1.55;
    -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    overflow-x: clip;
  }
  img { display: block; max-width: 100%; height: auto; }
  h1, h2, h3, p, ul, ol, figure { margin: 0; }
  ul, ol { padding: 0; list-style: none; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--teal-deep); outline-offset: 3px; border-radius: 4px; }
  .band--dark :focus-visible { outline-color: var(--teal); }

  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: var(--ink); color: var(--white); padding: 8px 14px; border-radius: var(--r-pill); }
  .skip:focus { left: 8px; }

  .wrap { width: 100%; max-width: calc(var(--max) + var(--gutter) * 2); margin: 0 auto; padding: 0 var(--gutter); }

  /* Type: four sizes only */
  .display { font-size: var(--fs-display); font-weight: 700; letter-spacing: -0.03em; line-height: 1.02; color: var(--ink); text-wrap: balance; }
  .section { font-size: var(--fs-section); font-weight: 700; letter-spacing: -0.02em; line-height: 1.08; color: var(--ink); text-wrap: balance; }
  .card { font-size: var(--fs-card); font-weight: 600; letter-spacing: -0.01em; line-height: 1.25; color: var(--ink); }
  .body, .lede { font-size: var(--fs-body); max-width: 65ch; }
  .eyebrow, .label { font-size: var(--fs-body); font-weight: 600; color: var(--dark-grey); }
  .meta { color: var(--dark-grey); font-weight: 600; }

  /* Bands */
  .band { position: relative; padding: var(--pad-band) 0; }
  .band--grey { background: var(--grey-50); }
  .band--dark { background: var(--ink); color: var(--grey-200); isolation: isolate; }
  .band--dark .section, .band--dark .card { color: var(--white); }
  .band--dark .eyebrow { color: var(--grey-500); }
  .texture {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: var(--texture) repeat 0 0 / 120px auto; opacity: var(--texture-opacity);
    -webkit-mask-image: radial-gradient(120% 90% at 100% 0, #000, rgba(0,0,0,.6) 30%, transparent 62%);
            mask-image: radial-gradient(120% 90% at 100% 0, #000, rgba(0,0,0,.6) 30%, transparent 62%);
  }
  .band__head { display: grid; gap: 14px; margin-bottom: clamp(32px, 5vw, 64px); }
