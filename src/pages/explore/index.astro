---
import Base from '../../layouts/Base.astro';
const directions = [
  { slug: 'a', name: 'Direction A · White Room', status: 'Draft', live: true },
  { slug: 'b', name: 'Direction B', status: 'Coming soon' },
  { slug: 'c', name: 'Direction C', status: 'Coming soon' },
];
---
<Base title="Explorations · Dunn Creative">
  <p class="eyebrow">Explorations</p>
  <h1>Landing page directions</h1>
  <p>Each direction is a full landing page built from one moodboard. Freeman picks one; it grows into the full site.</p>
  <ul>
    {directions.map((d) => <li><strong>{d.name}</strong> · {d.live ? <a href={`/explore/${d.slug}/`}>/explore/{d.slug}</a> : `/explore/${d.slug}`} · {d.status}</li>)}
  </ul>
</Base>
