---
// Task #45 · v04 · 1 · Type specimen (Cole directs, Kai builds).
// One noindex page comparing the two type options in Website Master Brief v04 §3 on the same copy:
//   Option 1: Inter Display Light headlines (Inter at its display optical size), Instrument Serif
//             Italic for ONE accent word, Inter body. Google Fonts.
//   Option 2: General Sans headlines and labels (Fontshare, free), Inter body, no serif.
// Copy is the Home K hero and services lines from draft PR #10, the locked Brand Identity
// sub-services (Master Brief v04 §4) and the Home K founder paragraph. Nothing new is claimed.
// Freeman picks; no other page changes fonts until he does. Not linked from nav or footer.
const subServices = [
  'Positioning session',
  'Logo and identity system',
  'Brand guidelines',
  'Messaging and voice',
  'Branded imagery (human-led AI)',
  'Brand refresh',
];

const options = [
  {
    id: 'option-1',
    n: 'Option 1',
    name: 'Inter Display Light + Instrument Serif Italic accent + Inter body',
    note: 'The brief’s recommendation. Editorial mix, closest to Unfold. Free on Google Fonts. Serif on one word only.',
  },
  {
    id: 'option-2',
    n: 'Option 2',
    name: 'General Sans headlines and labels + Inter body, no serif',
    note: 'Free from Fontshare. One sans voice for headlines and labels; no accent face.',
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Type specimen · Dunn Creative (exploration)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300..600&family=Instrument+Serif:ital@1&display=swap"
      rel="stylesheet"
    />
    <link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --white: #fff;
        --g50: #f5f5f7;
        --g200: #e3e3e6;
        --caption: #6b6e72;
        --dg: #333;
        --ink: #0b0c0d;
        --teal: #1aa6aa;
        --teal-deep: #10777a;
        --r-tile: 22px;
        --r-btn: 10px;
        --max: 1240px;
        --gut: clamp(16px, 4vw, 48px);
        --inter: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
        --serif: 'Instrument Serif', Georgia, serif;
        --general: 'General Sans', 'Inter', system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--white);
        color: var(--dg);
        font-family: var(--inter);
        font-size: 17px;
        line-height: 1.55;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: var(--max); margin: 0 auto; padding: 0 var(--gut); }
      h1, h2, h3, p { margin: 0; }

      /* Page chrome: plain Inter so it doesn't take sides. */
      .top { border-bottom: 1px solid var(--g200); padding: 18px 0; }
      .top .wrap { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: baseline; justify-content: space-between; }
      .top strong { color: var(--ink); font-weight: 600; font-size: 15px; }
      .top span { color: var(--caption); font-size: 14px; }
      .intro { padding: 48px 0 8px; }
      .intro h1 { font: 600 28px/1.2 var(--inter); color: var(--ink); letter-spacing: -0.01em; }
      .intro p { margin-top: 12px; max-width: 62ch; }
      .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
      .jump a { font: 500 14px/1 var(--inter); color: var(--ink); text-decoration: none; border: 1px solid var(--g200); border-radius: 999px; padding: 9px 14px; }
      .jump a:hover { border-color: var(--ink); }

      .opt { padding: 56px 0 72px; border-top: 1px solid var(--g200); margin-top: 48px; scroll-margin-top: 16px; }
      .opthead { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: baseline; margin-bottom: 40px; }
      .opthead .tag { font: 600 13px/1 var(--inter); color: var(--white); background: var(--ink); border-radius: 999px; padding: 7px 12px; }
      .opthead h2 { font: 600 18px/1.3 var(--inter); color: var(--ink); }
      .opthead p { flex-basis: 100%; color: var(--caption); font-size: 15px; }
      .spec { font: 500 12px/1.4 var(--inter); color: var(--caption); margin: 0 0 14px; letter-spacing: 0; }
      .spec b { color: var(--ink); font-weight: 600; }

      .tile { border-radius: var(--r-tile); padding: clamp(24px, 5vw, 64px); }
      .tile + .tile { margin-top: 20px; }
      .light { background: var(--g50); }
      .white { background: var(--white); border: 1px solid var(--g200); }
      .dark { background: var(--ink); color: #c9cbce; }

      .lbl { margin: 0 0 18px; }
      .hero h1 { color: var(--ink); max-width: 18ch; }
      .stand { margin-top: 24px; max-width: 56ch; font-size: 19px; line-height: 1.5; }
      .ctas { display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: center; margin-top: 32px; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px;
        border-radius: var(--r-btn); background: var(--teal); color: var(--ink); border: 1px solid var(--teal);
        font: 600 16px/1 var(--inter); text-decoration: none; white-space: nowrap;
      }
      .btn.ghost { background: transparent; border-color: var(--ink); }
      .dark .btn.ghost { border-color: rgba(255, 255, 255, 0.55); color: #fff; }

      .svc { display: grid; gap: 28px; grid-template-columns: 1fr; }
      .svc h2 { color: var(--ink); }
      .svc .line { margin-top: 12px; max-width: 40ch; }
      .svc ul { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 32px; }
      .svc li { break-inside: avoid; padding: 12px 0; border-top: 1px solid var(--g200); font-size: 16px; color: var(--ink); }

      .body { display: grid; gap: 32px; grid-template-columns: 1fr; }
      .body p + p { margin-top: 16px; }
      .body .prose { max-width: 62ch; }
      .labels { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 8px; }
      .dark h2 { color: #fff; }

      @media (min-width: 900px) {
        .svc { grid-template-columns: 5fr 7fr; gap: 48px; }
        .body { grid-template-columns: 7fr 5fr; gap: 48px; }
      }
      @media (max-width: 560px) {
        .svc ul { columns: 1; }
        .stand { font-size: 17px; }
      }

      /* ---------- Option 1: Inter Display Light, one Instrument Serif Italic word ---------- */
      .o1 .h-display {
        font-family: var(--inter);
        font-weight: 300;
        font-optical-sizing: auto;
        font-variation-settings: 'opsz' 32;
        letter-spacing: -0.035em;
      }
      .o1 .hero h1 { font-size: clamp(40px, 6.4vw, 84px); line-height: 1.02; }
      .o1 .accent { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; }
      .o1 .svc h2, .o1 .dark h2 { font-size: clamp(30px, 3.6vw, 48px); line-height: 1.08; }
      .o1 .lbl { font: 500 12px/1.3 var(--inter); letter-spacing: 0.14em; text-transform: uppercase; color: var(--caption); }
      .o1 .dark .lbl { color: #9a9da1; }

      /* ---------- Option 2: General Sans headlines and labels, no serif ---------- */
      .o2 .h-display { font-family: var(--general); font-weight: 500; letter-spacing: -0.03em; }
      .o2 .hero h1 { font-size: clamp(40px, 6.2vw, 80px); line-height: 1.02; }
      .o2 .svc h2, .o2 .dark h2 { font-size: clamp(30px, 3.6vw, 48px); line-height: 1.08; }
      .o2 .lbl { font: 500 12px/1.3 var(--general); letter-spacing: 0.14em; text-transform: uppercase; color: var(--caption); }
      .o2 .dark .lbl { color: #9a9da1; }
      .o2 .btn { font-family: var(--general); }

      .foot { border-top: 1px solid var(--g200); padding: 28px 0 56px; color: var(--caption); font-size: 14px; }
    </style>
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <strong>Dunn Creative · Type specimen</strong>
        <span>Exploration, not linked from the site · Task v04 · 1 · 25 Nov 2026</span>
      </div>
    </header>

    <main>
      <section class="intro">
        <div class="wrap">
          <h1>Two type options, same copy.</h1>
          <p>
            Each option sets the Home hero, a service block, body copy at 17px, small spaced labels and the
            buttons. Colors, spacing and copy are identical, so only the type changes. Your pick locks the
            site’s type.
          </p>
          <nav class="jump" aria-label="Options">
            <a href="#option-1">Option 1 · Inter Display + Instrument Serif</a>
            <a href="#option-2">Option 2 · General Sans + Inter</a>
          </nav>
        </div>
      </section>

      {options.map((o, i) => (
        <section class={`opt ${i === 0 ? 'o1' : 'o2'}`} id={o.id} aria-labelledby={`${o.id}-title`}>
          <div class="wrap">
            <div class="opthead">
              <span class="tag">{o.n}</span>
              <h2 id={`${o.id}-title`}>{o.name}</h2>
              <p>{o.note}</p>
            </div>

            <p class="spec">
              <b>Home hero</b> ·{' '}
              {i === 0
                ? 'Inter Display Light (300), tracking −3.5%; accent word in Instrument Serif Italic'
                : 'General Sans Medium (500), tracking −3%'}
              {' '}· stand line Inter 19px
            </p>
            <div class="tile light hero">
              <p class="lbl">Creative studio · Jackson, WY</p>
              <h1 class="h-display">
                Creative that strengthens how a brand looks and how it{' '}
                {i === 0 ? <span class="accent">performs</span> : 'performs'}.
              </h1>
              <p class="stand">
                From foundational branding to websites, content and campaigns, Dunn Creative brings strategy,
                design and execution together, so your brand shows up with more clarity, consistency and impact.
              </p>
              <div class="ctas">
                <a class="btn" href={`#${o.id}`}>Let’s talk</a>
                <a class="btn ghost" href={`#${o.id}`}>Get a free audit</a>
              </div>
            </div>

            <p class="spec" style="margin-top:36px">
              <b>Service block</b> · area title {i === 0 ? 'Inter Display Light' : 'General Sans Medium'} · line and
              sub-services Inter
            </p>
            <div class="tile white svc">
              <div>
                <p class="lbl">01 · Flagship</p>
                <h2 class="h-display">Brand Identity</h2>
                <p class="line">Build a brand with clarity, character and consistency.</p>
              </div>
              <ul>
                {subServices.map((s) => <li>{s}</li>)}
              </ul>
            </div>

            <p class="spec" style="margin-top:36px">
              <b>Body copy</b> · Inter 17px / 1.55 · labels {i === 0 ? 'Inter' : 'General Sans'} 12px, spaced caps
            </p>
            <div class="tile white body">
              <div class="prose">
                <p class="lbl">Founder</p>
                <p>
                  Every project is directed by Chris Dunn. 20+ years in creative direction, brand, web and content,
                  most of it in action sports, film and lifestyle, where the work has to look as good as the footage.
                </p>
                <p>
                  Dunn Creative works with founder-led and family-run businesses whose brand hasn’t caught up with
                  their work: outdoor and lifestyle brands, filmmakers and athletes, wellness studios and retreats,
                  and established local companies ready to modernize.
                </p>
              </div>
              <div>
                <p class="lbl">Small labels</p>
                <div class="labels">
                  <span class="lbl" style="margin:0">Work</span>
                  <span class="lbl" style="margin:0">Services</span>
                  <span class="lbl" style="margin:0">Sprints</span>
                  <span class="lbl" style="margin:0">Lab</span>
                  <span class="lbl" style="margin:0">About</span>
                </div>
              </div>
            </div>

            <p class="spec" style="margin-top:36px"><b>On a dark panel</b> · same settings, white on ink</p>
            <div class="tile dark">
              <p class="lbl">Sprints</p>
              <h2 class="h-display">Start small. Scale when it works.</h2>
              <div class="ctas">
                <a class="btn" href={`#${o.id}`}>Start a sprint</a>
                <a class="btn ghost" href={`#${o.id}`}>Let’s talk</a>
              </div>
            </div>
          </div>
        </section>
      ))}
    </main>

    <footer class="foot">
      <div class="wrap">
        Fonts load from Google Fonts (Inter, Instrument Serif) and Fontshare (General Sans) for this comparison
        only. Whichever wins gets self-hosted in the site build.
      </div>
    </footer>
  </body>
</html>
