---
// Lab (v04 · 12): Freeman's 27 Nov pick, A · Lab (public/explore/design-a/lab-v2.html), on the Direction A template.
// Pieces: src/data/lab.ts (titles kept as live); images and lines: src/data/labPosts.ts. Only Celtic / triskele has
// images so far; the other pieces show a marked placeholder until Freeman's images and words arrive.
// The 24 Nov Lab B markup (src/v2/lab.html) stays in the repo until Freeman confirms it can go.
import A from '../../layouts/A.astro';
import AHero from '../../components/a/AHero.astro';
import ASection from '../../components/a/ASection.astro';
import Steps from '../../components/a/Steps.astro';
import CtaPanel from '../../components/a/CtaPanel.astro';
import { lab, labHref, type LabPiece } from '../../data/lab';
import { labPosts, labHero, labKinds } from '../../data/labPosts';
import { SHOW_HELD } from '../../lib/held';
import { TALK } from '../../lib/site';
import { rich } from '../../lib/rich';
import type { Hero } from '../../lib/a';
const hero: Hero = { ...labHero, ctas: [{ label: 'Read the pieces ↓', href: '#pieces', style: 'light' }, { label: 'Let’s talk', href: TALK, style: 'light-o' }] };
// Celtic first (the one piece with images), then the rest in their lab.ts order.
const pieces = [...lab].sort((a, b) => Number(Boolean(labPosts[b.slug]?.card)) - Number(Boolean(labPosts[a.slug]?.card)));
const title = (p: LabPiece) => (p.titleHeld ? (SHOW_HELD ? 'Field guide title to come' : p.label) : p.title);
---
<A title="Lab · Dunn Creative" description="Chris Dunn's experiments, series and notes. Every piece says what was AI-assisted.">
  <AHero hero={hero} />
  <section class="a-wrap a-sec is-tight" id="pieces" aria-label="Lab pieces">
    <ul class="a-cards is-narrow" style="gap:48px 24px">
      {pieces.map((p) => {
        const post = labPosts[p.slug];
        return (
          <li><a class="a-wcard" href={labHref(p.slug)}>
            <div class="a-media" style="aspect-ratio:4/3">
              {post?.card
                ? <><img src={post.card.src} alt={post.card.alt} loading="lazy" decoding="async" /><span class="a-pill">AI-directed image</span></>
                : <div class="a-ph">{SHOW_HELD ? 'Lab image · placeholder' : ''}</div>}
            </div>
            <p class="a-eyebrow">{p.label}</p>
            <h2 class="a-d a-wcard__name">{title(p)}</h2>
            <p class="a-wcard__line" set:html={post?.line && SHOW_HELD ? rich(`${post.line} [[Placeholder line]]`) : rich('[[To come: one line]]')} />
          </a></li>
        );
      })}
      <li class="a-card" style="justify-content:space-between;gap:20px">
        <p class="a-eyebrow">The Lab, by email</p>
        <h2 class="a-d" style="font-size:clamp(32px,3.2vw,44px);line-height:1.05">New Lab drops, by <em>email</em>.</h2>
        <p><span class="held">To come: email tool and send rhythm</span></p>
      </li>
    </ul>
  </section>
  <ASection title="What’s in the *Lab*" size="md" space="tight">
    <Steps steps={labKinds} tone="light" />
  </ASection>
  <CtaPanel cta={{ title: 'Want this thinking on your *brand?*', lead: 'The same curiosity goes into client work: brand, websites, marketing creative and AI.', ctas: [{ label: 'Start a project', href: TALK, style: 'teal' }, { label: 'Get in touch', href: TALK, style: 'dark-o' }] }} />
</A>
