---
// Lab post template: Lab post B, Freeman's 24 Nov pick, reworked per his note: Lab post A's title and
// lead image, then E's fact strip, numbered sections and AI band. Nothing is written yet, so every
// body is a "To come" chip under the real section titles from src/data/lab.ts (held: lab-posts, lab-ai).
import V2 from '../../layouts/V2.astro';
import { lab, labHref, type LabPiece } from '../../data/lab';
import { TALK } from '../../lib/site';

export function getStaticPaths() {
  return lab.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, nextTwo: [lab[(i + 1) % lab.length], lab[(i + 2) % lab.length]] },
  }));
}
const { p, nextTwo } = Astro.props as { p: LabPiece; nextTwo: LabPiece[] };
const title = p.titleHeld ? 'Field guide title to come' : p.title;
const n = (i: number) => String(i + 1).padStart(2, '0');
const [first, second, ...rest] = p.sections;
const tones = ['ink', 'stone', 'fog'];
const lc = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
---
<V2 title={`${p.titleHeld ? p.label : p.title} · Lab · Dunn Creative`} description={`${p.label} from the Dunn Creative Lab.`}>
  <section class="band tight"><div class="wrap"><div class="read">
    <p class="lbl">Lab · {p.label}</p>
    <h1 style="font-size:clamp(40px,6vw,80px);font-weight:400;letter-spacing:-.04em;line-height:1;margin:14px 0 22px">{title}</h1>
    <p class="stand" style="max-width:none"><span class="held">To come: standfirst</span></p>
    <div style="margin-top:28px"><div class="author">
      <img src="/v2/assets/chris-portrait.webp" alt="Chris Dunn" loading="lazy" decoding="async" />
      <div><b>Chris Dunn</b><span class="cap" style="margin:0">Founder and creative director</span></div>
      <span style="margin-left:auto"><span class="held">To come: publish date</span></span>
    </div></div>
  </div></div></section>
  <div class="wrap"><div class="wide">
    <div class="grad ink" style="aspect-ratio:16/9;">Lead image · Fig. 01</div>
    <p class="cap">Fig. 01 · Caption to come.</p>
  </div></div>
  <section class="band tight"><div class="wrap">
    <dl class="fstrip">
      <div><dt>Type</dt><dd>{p.label}</dd></div>
      <div><dt>Topic</dt><dd>{p.titleHeld ? <span class="held">To come: topic</span> : p.title}</dd></div>
      <div><dt>Tools</dt><dd><span class="held">To come: tools</span></dd></div>
      <div><dt>AI use</dt><dd><span class="held">To come: what AI did</span></dd></div>
      <div><dt>Year</dt><dd><span class="held">To come: year</span></dd></div>
    </dl>
  </div></section>
  <section class="band" style="padding-top:0"><div class="wrap">
    <div class="read">
      <p class="lbl" style="margin-top:56px">01</p>
      <h2 style="margin-top:8px">{first}</h2>
      <p><span class="held">To come: {lc(first)} copy</span></p>
      <p class="lbl" style="margin-top:56px">02</p>
      <h2 style="margin-top:8px">{second}</h2>
      {p.kind !== 'series' && <p><span class="held">To come: {lc(second)} copy</span></p>}
    </div>
    {p.kind === 'series' && (
      <div class="wide" style="margin:clamp(36px,5vw,56px) auto">
        <div class="mods c2" style="grid-template-columns:2fr 1fr"><div class="grad stone" style="aspect-ratio:4/3;">Fig. 02</div><div class="grad " style="aspect-ratio:2/3;">Fig. 03</div></div>
        <div class="mods c3" style="grid-template-columns:repeat(3,1fr);margin-top:12px"><div class="grad " style="aspect-ratio:1/1;">Fig. 04</div><div class="grad ink" style="aspect-ratio:1/1;">Fig. 05</div><div class="grad fog" style="aspect-ratio:1/1;">Fig. 06</div></div>
        <div style="margin-top:12px"><div class="grad ink" style="aspect-ratio:21/9;">Fig. 07 · full width</div></div>
        <p class="cap">The series: one large, one tall, a row of three, then full width. Captions to come.</p>
      </div>
    )}
    <div class="read">
      {rest.map((s, i) => (
        <>
          <p class="lbl" style="margin-top:56px">{n(i + 2)}</p>
          <h2 style="margin-top:8px">{s}</h2>
          <p><span class="held">To come: {lc(s)} copy</span></p>
        </>
      ))}
    </div>
  </div></section>
  <section class="band dark tex"><div class="wrap split">
    <div><p class="lbl">{n(p.sections.length)} · AI use</p><h2 style="margin-top:14px">What AI did on this piece.</h2></div>
    <div><p><span class="held">To come: what AI did on this piece</span></p><p class="stand" style="margin-top:16px">Every Lab piece says what was AI-assisted.</p></div>
  </div></section>
  <section class="band tight"><div class="wrap"><div class="read"><div class="tags"><span>{p.label}</span><span>Lab</span></div></div></div></section>
  <section class="band grey"><div class="wrap">
    <div class="sechead"><h2>Next in the Lab</h2><a class="tlink" href="/lab/">The Lab +</a></div>
    <div class="wrow r2">
      {nextTwo.map((x, i) => (
        <a class="wc" href={labHref(x.slug)}>
          <div class={`grad ${tones[i % 3]}`} style="aspect-ratio:16/10;">Lab image</div>
          <p class="lbl">{x.label}</p><h3>{x.titleHeld ? 'Field guide title to come' : x.title}</h3>
        </a>
      ))}
    </div>
  </div></section>
  <section class="band cta" id="talk"><div class="wrap">
    <h2>Want this thinking on your brand?</h2>
    <div class="side"><p class="stand">Tell us what you're building.</p><span class="held">To come: response time</span><a class="btn" href={TALK}>Let's talk</a></div>
  </div></section>
</V2>
