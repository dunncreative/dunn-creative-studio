---
// Lab post template (v04 · 12): Freeman's 27 Nov pick, A · Lab post · Celtic triskele
// (public/explore/design-a/lab-post-celtic.html), on the Direction A template. One template for every piece in
// src/data/lab.ts; images, facts and blocks come from src/data/labPosts.ts. Only /lab/celtic-triskele/ has images.
//
// Nothing in the Lab is written yet. Deploy Previews show the artboard's placeholder copy with a "Placeholder copy"
// chip and held chips for the rest; production (CONTEXT=production) leaves placeholder copy out and says
// "Full story coming soon." (as the live Lab posts did, v04 · 10 QA).
import A from '../../layouts/A.astro';
import AHero from '../../components/a/AHero.astro';
import FactStrip from '../../components/a/FactStrip.astro';
import CtaPanel from '../../components/a/CtaPanel.astro';
import { lab, labHref, type LabPiece } from '../../data/lab';
import { labPosts, type LabPost } from '../../data/labPosts';
import { SHOW_HELD } from '../../lib/held';
import { TALK } from '../../lib/site';
import { rich, plain, nn } from '../../lib/rich';
import type { Hero } from '../../lib/a';

export function getStaticPaths() {
  return lab.map((p, i) => ({ params: { slug: p.slug }, props: { p, nextTwo: [lab[(i + 1) % lab.length], lab[(i + 2) % lab.length]] } }));
}
const { p, nextTwo } = Astro.props as { p: LabPiece; nextTwo: LabPiece[] };
const live = !SHOW_HELD;
const cardTitle = (x: LabPiece) => (x.titleHeld ? (live ? x.label : 'Field guide title to come') : x.title);
const title = cardTitle(p);
// Pieces without their own post data get the template's blocks under their real section titles, all held.
const post: LabPost = labPosts[p.slug] ?? {
  facts: [['Type', p.label], ['Topic', p.titleHeld ? '[[To come: topic]]' : p.title], ['Tools', '[[To come: tools]]'], ['AI use', '[[To come: what AI did]]'], ['Year', '[[To come: year]]']],
  blocks: p.sections.map((s) => ({ title: s })),
  ai: '',
};
// The hero needs an image: pieces without one use the Lab's spare galaxy image, tagged as a placeholder.
const hero: Hero = {
  eyebrow: `Lab · ${p.label}`,
  title: p.slug === 'celtic-triskele' ? 'Celtic / *triskele*' : title,
  line: live ? 'Full story coming soon.' : (post.line ? `${post.line} [[Placeholder line]]` : '[[To come: standfirst]]'),
  image: post.hero
    ? { ...post.hero }
    : { src: '/explore/design-a/assets/heroes/spare-hero-galaxy-bw.webp', w: 1152, h: 768, pos: 'center 50%', tag: 'Placeholder image · AI-directed' },
  ctas: [{ label: 'Start reading ↓', href: '#read', style: 'light' }, { label: 'All Lab pieces', href: '/lab/', style: 'light-o' }],
  height: 560,
};
const lc = (s: string) => plain(s).charAt(0).toLowerCase() + plain(s).slice(1);
const nextCard = (x: LabPiece) => labPosts[x.slug]?.card;
---
<A title={`${p.titleHeld ? p.label : p.title} · Lab · Dunn Creative`} description={`${p.label} from the Dunn Creative Lab. Every piece says what was AI-assisted.`}>
  <AHero hero={hero} />

  <section class="a-wrap a-sec is-tight" id="read">
    <div class="a-read">
      <div class="a-author">
        <img src="/v2/assets/chris-portrait.webp" alt="Chris Dunn" width="52" height="52" loading="lazy" decoding="async" />
        <div><b>Chris Dunn</b><span>Founder and creative director</span></div>
        {!live && <span style="margin-left:auto"><span class="held">Placeholder copy · date to come</span></span>}
      </div>
      <FactStrip facts={post.facts} style="margin-top:28px" />
    </div>
  </section>

  <section class="a-wrap a-sec is-flush">
    {post.blocks.map((b, i) => (
      <>
        <div class="a-read" style="margin-top:56px">
          <p class="a-eyebrow">{nn(i + 1)}</p>
          <h2 class="a-d" set:html={rich(b.title)} />
          {!live && (b.draft
            ? <p class="a-body">{b.draft} <span class="held">Placeholder copy</span></p>
            : <p class="a-body"><span class="held">To come: {lc(b.title)} copy</span></p>)}
        </div>
        {b.rows && (
          <figure class={`a-gallery${b.well ? ' is-well' : ''}`}>
            {b.rows.map((r) => (
              <div class="a-gallery__row" style={`--min:${r.min}px;--ar:${r.ar}`}>
                {r.images.map((im) => <div class="a-media"><img src={im.src} alt={im.alt} loading="lazy" decoding="async" /><span class="a-pill">AI-directed image</span></div>)}
              </div>
            ))}
            {b.caption && <figcaption class="a-cap">{b.caption}</figcaption>}
          </figure>
        )}
      </>
    ))}
  </section>

  <section class="a-wrap a-sec is-tight">
    <div class="a-band">
      <div><p class="a-eyebrow">AI use</p><h2 class="a-d a-h2 is-md">What AI did on this <em>piece</em>.</h2></div>
      <div>
        {post.ai && <p class="a-body" style="color:#fff">{post.ai}</p>}
        <p style="margin-top:12px"><span class="held">To come: tools and what AI did</span></p>
        <p class="a-body" style="margin-top:12px">Every Lab piece says what was AI-assisted.</p>
      </div>
    </div>
  </section>

  <section class="a-wrap a-sec is-tight">
    <div class="a-shead"><h2 class="a-d a-h2">Next in the <em>Lab</em></h2><a class="a-link" href="/lab/">The Lab →</a></div>
    <ul class="a-work">
      {nextTwo.map((x) => (
        <li><a class="a-wcard" href={labHref(x.slug)}>
          <div class="a-media" style="aspect-ratio:16/10">
            {nextCard(x) ? <><img src={nextCard(x)!.src} alt={nextCard(x)!.alt} loading="lazy" decoding="async" /><span class="a-pill">AI-directed image</span></> : <div class="a-ph">{live ? '' : 'Lab image · placeholder'}</div>}
          </div>
          <p class="a-eyebrow">{x.label}</p>
          <h3 class="a-d a-wcard__name">{cardTitle(x)}</h3>
        </a></li>
      ))}
    </ul>
  </section>

  <CtaPanel cta={{ title: 'Want this thinking on your *brand?*', lead: 'Tell us what you’re building.', ctas: [{ label: 'Let’s talk', href: TALK, style: 'teal' }, { label: 'Get a free audit', href: '/contact/?way=free#audit', style: 'dark-o' }] }} />
</A>
