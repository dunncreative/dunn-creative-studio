---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Work from '../../layouts/Work.astro';
import WorkFigure from '../../components/WorkFigure.astro';
import { clean, cleanList, isAiImage } from '../../lib/placeholders';
import Held from '../../components/Held.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import { SHOW_HELD } from '../../lib/held';
import CtaBox from '../../components/CtaBox.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('work', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  const cases = entries.filter((e) => e.data.kind === 'case-study');
  return entries.map((entry) => {
    let next: CollectionEntry<'work'> | undefined;
    if (entry.data.kind === 'case-study') {
      const i = cases.findIndex((c) => c.id === entry.id);
      next = cases[(i + 1) % cases.length];
    } else {
      next = cases[0];
    }
    return { params: { slug: entry.id }, props: { entry, next } };
  });
}

const { entry, next } = Astro.props as { entry: CollectionEntry<'work'>; next?: CollectionEntry<'work'> };
const d = entry.data;
const isCase = d.kind === 'case-study';
const { Content } = await render(entry);
const [hero, ...media] = d.images;
const spec = d.spec ?? {};
// Unanswered studio notes ("[confirm]", "[held: …]") are stripped; an empty field hides its row.
const deliverables = cleanList(spec.deliverables);
const channels = cleanList(spec.channels);
const specItems = [
  clean(spec.timeline) && ['Timeline', clean(spec.timeline)],
  deliverables.length && ['Deliverables', deliverables.join(' · ')],
  channels.length && ['Channels', channels.join(' · ')],
  clean(spec.aiUsed) && ['AI used', clean(spec.aiUsed)],
].filter(Boolean) as [string, string][];
// Wireframe v02.1 holds: year/duration and AI used stay visible as Held chips on case studies
// while they're unanswered; Deeper also holds its challenge copy and the DVD menu asset.
const holdYear = isCase && !clean(spec.timeline);
const holdAi = isCase && !clean(spec.aiUsed);
const isDeeper = entry.id === 'jeremy-jones-deeper';
const liveHost = d.liveUrl ? new URL(d.liveUrl).hostname.replace(/^www\./, '') : null;
---
<Work title={`${d.title} · Work · Dunn Creative`} description={d.summary}>
  {isCase ? (
    <header slot="head" class="local">
      <div class="wrap">
        <a href="/work/" class="crumb">Work</a>
        <strong>{d.title}</strong>
        <a class="ghost" href="/contact/">Start a project</a>
      </div>
    </header>
  ) : null}

  {isCase ? (
    <>
      <section class="band dark hero">
        <div class="wrap">
          <p class="label">Case study · {d.client}</p>
          <h1>{d.title}</h1>
          <p class="lede">{d.summary}</p>
        </div>
        <WorkFigure class="wrap heroimg" image={hero} ground="dark" />
      </section>

      <section class="band">
        <dl class="wrap spec">
          {holdYear && <div><dt class="label">Timeline</dt><dd><Held id="case-year" /></dd></div>}
          {specItems.map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
          {holdAi && <div><dt class="label">AI used</dt><dd><Held id="case-ai" /></dd></div>}
          {d.liveUrl && <div><dt class="label">Live site</dt><dd><a href={d.liveUrl} rel="noopener">{liveHost}</a></dd></div>}
        </dl>
      </section>

      <section class="band grey">
        <div class="wrap prose"><Content />{isDeeper && <Held id="deeper-challenge" block />}</div>
      </section>

      {media.map((m, i) => (
        <section class:list={['band', 'mediaband', i % 2 === 0 ? 'light' : 'dark']}>
          <WorkFigure class="wrap" image={m} ground={i % 2 === 0 ? 'light' : 'dark'} lazy />
        </section>
      ))}

      {isDeeper && (
        <section class:list={['band', 'mediaband', media.length % 2 === 0 ? 'light' : 'dark']}>
          <div class="wrap"><MediaSlot label="DVD menu" ratio="16 / 9" dark={media.length % 2 === 1} held="dvd-menu" /></div>
        </section>
      )}

      {!d.results && SHOW_HELD && (
        <section class="band grey tight">
          <div class="wrap"><h2>Results</h2><Held id="results" block note="results: real numbers or a client quote, or this band is left out" /></div>
        </section>
      )}

      {d.results && (
        <section class="band grey">
          <div class="wrap">
            <h2>Results</h2>
            <p class="lede">{d.results.text}</p>
            {d.results.source && <p class="label">{d.results.source}</p>}
          </div>
        </section>
      )}
    </>
  ) : (
    <section class="band">
      <div class="wrap snap">
        <p class="label">Snapshot · {d.disciplines.join(' · ')}</p>
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
        <p class="label">{d.services.join(' · ')}{d.liveUrl && <> · <a href={d.liveUrl} rel="noopener">{liveHost}</a></>}</p>
        <WorkFigure class="snapfig" image={hero} ground="grey" />
      </div>
    </section>
  )}

  {next && next.id !== entry.id && (
    <section class="band grey">
      <div class="wrap">
        <p class="label">{isCase ? 'Next project' : 'See a case study'}</p>
        <a class="nexttile" href={`/work/${next.id}/`}>
          <img src={next.data.images[0].src} alt={next.data.images[0].alt} loading="lazy" />
          <span><h2>{next.data.title}</h2>{isAiImage(next.data.images[0].caption) && <span class="label">Image: AI-directed mockup</span>}<span class="textcta">View +</span></span>
        </a>
      </div>
    </section>
  )}

  {isCase && <CtaBox title="Have a project in mind?" button="Start a project" href="/contact/" texture={false} />}
</Work>

<style>
  .local { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,.94); backdrop-filter: blur(8px); border-bottom: 1px solid var(--grey-200); }
  .local .wrap { display:flex; align-items:center; gap: 16px; height: 60px; }
  .local strong { color: var(--ink); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .local .ghost { padding: 10px 18px; }
  .crumb { color: var(--caption); text-decoration: none; }
  .hero .label { color: var(--grey-500); }
  .lede { margin: 16px 0 0; }
  .hero .lede { color: var(--grey-200); }
  .hero :global(.heroimg) { margin-top: 48px; }
  .hero :global(figcaption) { color: var(--grey-500); }
  .mediaband.light { background: var(--white); }
  .spec { display:grid; grid-template-columns: 1fr; gap: 20px; margin-top: 0; margin-bottom: 0; }
  @media (min-width: 720px) { .spec { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); } }
  .spec dd { margin: 4px 0 0; color: var(--ink); font-weight: 600; }
  .prose :global(h2) { margin-bottom: 16px; }
  .snap :global(.snapfig) { margin-top: 40px; }
  .nexttile { display:grid; gap: 20px; text-decoration: none; margin-top: 12px; }
  .nexttile img { border-radius: var(--r-tile); max-height: 420px; object-fit: cover; width: 100%; background: var(--white); }
  @media (min-width: 900px) { .nexttile { grid-template-columns: 2fr 1fr; align-items: center; } }
</style>
