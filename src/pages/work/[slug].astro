---
// Case study template: Case study G, Freeman's 24 Nov pick (a sticky project rail while the chapters
// scroll past; "revise and explore other options later"). Four case studies only (src/data/caseStudies.ts,
// copy v03 as written). The older project pages redirect to /work/ (netlify.toml); their content files stay.
//
// v04 · 12 (Freeman, 27 Nov late evening): KEEP THE LIVE CASE STUDY PAGES AS THEY ARE. Only the master template
// changes: the Direction A header and footer and the closing CTA panel come from the A layout; the body (hero,
// rail, chapters, images, captions, tags, AI labels and notes, Next project) is unchanged and still renders with
// public/v2/v2.css (`legacy`). Don't move them into the case-ironwood-v2 artboard layout.
import A from '../../layouts/A.astro';
import CtaPanel from '../../components/a/CtaPanel.astro';
import { caseStudies, caseHref, type CaseStudy, type CsImage } from '../../data/caseStudies';
import { TALK } from '../../lib/site';

export function getStaticPaths() {
  return caseStudies.map((cs, i) => ({ params: { slug: cs.slug }, props: { cs, next: caseStudies[(i + 1) % caseStudies.length] } }));
}
const { cs, next } = Astro.props as { cs: CaseStudy; next: CaseStudy };
const ratio = (im: CsImage) => `aspect-ratio:${im.w}/${im.h}`;
// A portrait image alone on its row is capped at 480px wide, so it doesn't run full width and very tall (QA #49).
const heroDark = cs.heroFit === 'contain';
const pill = 'AI-directed mockup';
---
<A title={`${cs.title} · Work · Dunn Creative`} description={cs.summary} legacy>
  <section class="lhero"><div class="wrap">
    <p class="lbl">Work / {cs.category}</p>
    <h1>{cs.title}</h1>
    <div class="lh2"><p class="stand">{cs.titleLine}</p><div class="ctas"><a class="btn ghost" href={`#${cs.chapters[0].id}`}>Start reading ↓</a></div></div>
  </div></section>
  <div class="wrap">
    <div class="media" style={`aspect-ratio:16/9${heroDark ? ';background:#0b0c0d' : ''}`}>
      <img src={cs.hero.src} alt={cs.hero.alt} width={cs.hero.w} height={cs.hero.h} decoding="async" style={heroDark ? 'object-fit:contain;height:100%' : 'height:100%'} />
      {cs.hero.ai && <span class="aipill" style="left:auto;right:12px;bottom:auto;top:12px">{pill}</span>}
    </div>
  </div>
  <section class="band"><div class="wrap tocgrid">
    <aside class="rail6">
      <p class="lbl teal">{cs.title}</p>
      <dl class="facts" style="position:static">
        {cs.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        {cs.liveUrl && <div><dt>Live site</dt><dd><a href={cs.liveUrl} rel="noopener">{new URL(cs.liveUrl).hostname.replace(/^www\./, '')}</a></dd></div>}
      </dl>
      <nav class="toc" aria-label="Chapters">
        {cs.chapters.map((c, i) => <a href={`#${c.id}`}>{String(i + 1).padStart(2, '0')} · {c.title}</a>)}
      </nav>
      <a class="tlink" href="/work/">All work +</a>
    </aside>
    <div>
      {cs.chapters.map((c, i) => (
        <section class="chap" id={c.id}>
          <p class="lbl">{String(i + 1).padStart(2, '0')}</p>
          <h2>{c.title}</h2>
          {c.text && <p class="stand">{c.text}</p>}
          {c.note && <p class="cap">{c.note}</p>}
          {c.images && (
            <div style="margin-top:28px;display:grid;gap:12px">
              {c.images.map((row) => (
                <div class={row.length > 1 ? 'mods c2' : ''} style={row.length > 1 ? 'align-items:start' : ''}>
                  {row.map((im) => (
                    <figure style={row.length === 1 && im.h > im.w ? 'margin:0;max-width:min(100%,480px)' : 'margin:0'}>
                      <div class="media" style={ratio(im)}>
                        <img src={im.src} alt={im.alt} width={im.w} height={im.h} loading="lazy" decoding="async" />
                        {im.ai && <span class="aipill">{pill}</span>}
                      </div>
                      {im.caption && <figcaption class="cap">{im.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              ))}
            </div>
          )}
          {c.held && <p style="margin-top:18px"><span class="held">{c.held}</span></p>}
          {c.tags && <div class="dlv">{c.tags.map((t) => <span>{t}</span>)}</div>}
        </section>
      ))}
    </div>
  </div></section>
  <section class="band grey"><div class="wrap">
    <p class="lbl" style="margin-bottom:18px">Next project</p>
    <a class="featw" href={caseHref(next.slug)}>
      <div class="wimg "><img src={next.card.src} alt={next.card.alt} loading="lazy" decoding="async" />{next.card.ai && <span class="aipill">{pill}</span>}</div>
      <div class="t"><p class="lbl">{next.category}</p><h2>{next.title}</h2><p>{next.summary}</p><span class="tlink" style="margin-top:18px">View project +</span></div>
    </a>
  </div></section>
  <CtaPanel cta={{
    title: 'Have a project in mind?',
    lead: 'Dunn Creative helps brands build identities, websites, content and campaigns that connect and perform.',
    ctas: [{ label: 'Start a project →', href: TALK, style: 'teal' }, { label: 'Get in touch', href: TALK, style: 'dark-o' }],
  }} />
</A>
