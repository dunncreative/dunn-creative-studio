---
// Case study and snapshot pages, per wireframes case-study_v02 and work_v02, in the Ridge look.
// Case study: ridge hero, the lead image, a ruled spec row, the story as numbered ruled sections,
// the rest of the images, Next project, then the closing band. A sticky "Start a project" follows
// the reader and steps aside when the closing band (with its own button) is on screen.
import { getCollection, type CollectionEntry } from 'astro:content';
import Work from '../../layouts/Work.astro';
import WorkFigure from '../../components/WorkFigure.astro';
import { clean, cleanList, isAiImage } from '../../lib/placeholders';
import Held from '../../components/Held.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import RidgeHero from '../../components/RidgeHero.astro';
import RidgeCta from '../../components/RidgeCta.astro';
import { SHOW_HELD } from '../../lib/held';
import { LOREM } from '../../lib/lorem';

export async function getStaticPaths() {
  const entries = (await getCollection('work', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  const cases = entries.filter((e) => e.data.kind === 'case-study');
  return entries.map((entry) => {
    let next: CollectionEntry<'work'> | undefined;
    if (entry.data.kind === 'case-study') {
      const i = cases.findIndex((c) => c.id === entry.id);
      next = cases[(i + 1) % cases.length];
    } else {
      next = cases[0];
    }
    return { params: { slug: entry.id }, props: { entry, next } };
  });
}

const { entry, next } = Astro.props as { entry: CollectionEntry<'work'>; next?: CollectionEntry<'work'> };
const d = entry.data;
const isCase = d.kind === 'case-study';
const [hero, ...media] = d.images;
const spec = d.spec ?? {};
// Unanswered studio notes ("[confirm]", "[held: …]") are stripped; an empty field hides its row.
const deliverables = cleanList(spec.deliverables);
const channels = cleanList(spec.channels);
const specItems = [
  ['Client', d.client],
  clean(spec.timeline) && ['Timeline', clean(spec.timeline)],
  deliverables.length && ['Deliverables', deliverables.join(', ')],
  channels.length && ['Channels', channels.join(', ')],
  clean(spec.aiUsed) && ['AI used', clean(spec.aiUsed)],
].filter(Boolean) as [string, string][];
// Wireframe v02.1 holds: year/duration and AI used stay visible as Held chips on case studies
// while they're unanswered; Deeper also holds its challenge copy and the DVD menu asset.
const holdYear = isCase && !clean(spec.timeline);
const holdAi = isCase && !clean(spec.aiUsed);
const isDeeper = entry.id === 'jeremy-jones-deeper';

// The write-up, split at its "## " headings into numbered sections. Bodies are plain paragraphs.
const sections = (entry.body ?? '')
  .split(/^## /m)
  .map((s) => s.trim())
  .filter(Boolean)
  .map((s) => {
    const [head, ...rest] = s.split('\n');
    return { title: head.trim(), paras: rest.join('\n').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean), lorem: false };
  });
// Case studies whose write-up stops at "Challenge" get the rest of the story's sections as
// real titles with lorem ipsum (Freeman, 18 Nov), so the page structure reads complete.
const extra = isCase && sections.length <= 1;
if (extra) for (const t of ['Approach', 'What we made', 'Outcome']) sections.push({ title: t, paras: [LOREM[0], LOREM[1]], lorem: true });
const liveHost = d.liveUrl ? new URL(d.liveUrl).hostname.replace(/^www\./, '') : null;
const nextImg = next?.data.cardImage ?? next?.data.images[0];
---
<Work title={`${d.title} · Work · Dunn Creative`} description={d.summary}>
  {isCase ? (
    <>
      <RidgeHero short texture={false} label={`${d.client} · ${d.disciplines.join(' · ')}`} title={d.title} stand={d.summary} meta={deliverables.slice(0, 5)}>
        <div class="ctas"><a class="textcta" href="#story">Read the story +</a></div>
      </RidgeHero>

      <section class="band dark mediaband">
        <WorkFigure class="wrap" image={hero} ground="dark" />
      </section>

      <section class="band tight">
        <div class="wrap">
          <dl class="spec">
            {specItems.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            {holdYear && <div><dt>Timeline</dt><dd><Held id="case-year" /></dd></div>}
            {holdAi && <div><dt>AI used</dt><dd><Held id="case-ai" /></dd></div>}
            {d.liveUrl && <div><dt>Live site</dt><dd><a href={d.liveUrl} rel="noopener">{liveHost}</a></dd></div>}
          </dl>
        </div>
      </section>

      <section class="band" id="story" style="padding-top:24px">
        <div class="wrap">
          {sections.map((s, i) => (
            <div class="casesec">
              <div><span class="n">{String(i + 1).padStart(2, '0')}</span><h2>{s.title}</h2></div>
              <div class="prose">
                {s.paras.map((p) => <p class:list={{ muted: s.lorem }}>{p}</p>)}
                {isDeeper && i === 0 && <p><Held id="deeper-challenge" /></p>}
              </div>
            </div>
          ))}
          {extra && <p style="margin-top:20px"><Held id="draft-copy" note="case study copy for Approach, What we made and Outcome" /></p>}
        </div>
      </section>

      {(media.length > 0 || isDeeper) && (
        <section class="band dark mediaband">
          <div class="wrap stack">
            {media.map((m) => <WorkFigure image={m} ground="dark" lazy />)}
            {isDeeper && <MediaSlot label="DVD menu" ratio="16 / 9" dark held="dvd-menu" />}
          </div>
        </section>
      )}

      {d.results ? (
        <section class="band tight">
          <div class="wrap split">
            <div><h2>Results</h2></div>
            <div><p class="stand">{d.results.text}</p>{d.results.source && <p class="cap">{d.results.source}</p>}</div>
          </div>
        </section>
      ) : SHOW_HELD && (
        <section class="band tight">
          <div class="wrap split">
            <div><h2>Results</h2></div>
            <div><p class="stand"><Held id="results" note="results: real numbers or a client quote" /></p><p class="cap">This band stays hidden on the live site until there is a real result to show.</p></div>
          </div>
        </section>
      )}
    </>
  ) : (
    <>
      <RidgeHero short label={`Snapshot · ${d.disciplines.join(' · ')}`} title={d.title} stand={d.summary} meta={[...d.services]}>
        {d.liveUrl && <div class="ctas"><a class="textcta" href={d.liveUrl} rel="noopener">{liveHost} +</a></div>}
      </RidgeHero>
      <section class="band">
        <div class="wrap"><WorkFigure image={hero} ground="grey" /></div>
      </section>
    </>
  )}

  {next && next.id !== entry.id && nextImg && (
    <section class="band grey">
      <div class="wrap">
        <p class="lbl" style="margin-bottom:18px">{isCase ? 'Next project' : 'See a case study'}</p>
        <a class="next" href={`/work/${next.id}/`}>
          <div class:list={['nimg', nextImg.ground && 'contain', nextImg.ground && `g-${nextImg.ground}`]}>
            <img src={nextImg.src} alt={nextImg.alt} loading="lazy" decoding="async" />
            {isAiImage(nextImg.caption) && <span class="ai-pill">AI-directed mockup</span>}
          </div>
          <div>
            <p class="lbl">{next.data.client} · {next.data.disciplines.join(' · ')}</p>
            <h2>{next.data.title}</h2>
            <p class="stand">{next.data.summary}</p>
          </div>
        </a>
      </div>
    </section>
  )}

  {isCase && (
    <>
      <RidgeCta title="Have a project in mind?" button="Start a project" href="/contact/" id="talk">
        <p class="stand">Tell us what you're building.</p>
      </RidgeCta>
      <div class="wrap sticky-cta" id="sticky"><a class="btn" href="/contact/">Start a project</a></div>
    </>
  )}
</Work>

{isCase && (
  <script>
    const s = document.getElementById('sticky');
    const c = document.getElementById('talk');
    if (s && c && 'IntersectionObserver' in window) {
      new IntersectionObserver((en) => s.classList.toggle('off', en[0].isIntersecting)).observe(c);
    }
  </script>
)}

<style>
  .mediaband :global(figure > img) { max-height: 82vh; }
  .stack { display: grid; gap: clamp(24px, 4vw, 48px); }
  .nimg { position: relative; border-radius: var(--r-tile); overflow: hidden; aspect-ratio: 4 / 3; background: var(--white); }
  .nimg img { width: 100%; height: 100%; object-fit: cover; }
  .nimg.contain img { object-fit: contain; padding: 10%; }
  .nimg.g-dark { background: var(--ink); }
</style>
