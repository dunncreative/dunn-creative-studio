---
// Privacy (footer link). NOT a real policy: section titles with lorem ipsum until the text is written.
import Work from '../layouts/Work.astro';
import Held from '../components/Held.astro';
import { LOREM } from '../lib/lorem';
import { EMAIL } from '../lib/site';
const sections = ['What we collect', 'How we use it', 'Who we share it with', 'Cookies and analytics', 'How long we keep it', 'Your choices', 'Contact'];
---
<Work title="Privacy · Dunn Creative" description="Dunn Creative privacy policy.">
  <section class="band">
    <div class="wrap narrow">
      <p class="eyebrow">Privacy</p>
      <h1>Privacy policy</h1>
      <p class="lede">Placeholder only. This page is not a privacy policy yet.</p>
      <p class="meta"><Held id="privacy-copy" block /></p>
    </div>
  </section>
  <section class="band grey">
    <div class="wrap narrow">
      {sections.map((t, i) => (
        <section class="sec">
          <h2>{t}</h2>
          {t === 'Contact'
            ? <p>Questions about this policy: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
            : <><p>{LOREM[i % 3]}</p><p>{LOREM[(i + 1) % 3]}</p></>}
        </section>
      ))}
    </div>
  </section>
</Work>
<style>
  .narrow { max-width: 820px; }
  .sec + .sec { margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--grey-200); }
  .sec h2 { font-size: var(--fs-card); margin-bottom: 12px; }
</style>
