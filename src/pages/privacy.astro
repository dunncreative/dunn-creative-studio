---
// Privacy (footer link), on the V2 layout and footer (v04 · 10 QA). NOT a policy: studio agents never draft
// legal text (held: privacy-copy). The live site (CONTEXT=production) shows one neutral holding line;
// Deploy Previews keep the section titles with lorem ipsum so the shape can be reviewed.
import V2 from '../layouts/V2.astro';
import Held from '../components/Held.astro';
import { LOREM } from '../lib/lorem';
import { SHOW_HELD } from '../lib/held';
import { EMAIL, TALK } from '../lib/site';
const sections = ['What we collect', 'How we use it', 'Who we share it with', 'Cookies and analytics', 'How long we keep it', 'Your choices', 'Contact'];
---
<V2 title="Privacy · Dunn Creative" description="Dunn Creative privacy.">
  <section class="lhero"><div class="wrap">
    <p class="lbl">Privacy</p>
    <h1>Privacy</h1>
    <div class="lh2">
      {SHOW_HELD
        ? <p class="stand">Placeholder only. This page is not a privacy policy yet. <Held id="privacy-copy" /></p>
        : <p class="stand">Our privacy policy is being finalized. Ask us anything on the <a href={TALK}>contact page</a>.</p>}
      <div class="ctas"><a class="tlink" href={`mailto:${EMAIL}`}>{EMAIL}</a></div>
    </div>
  </div></section>
  {SHOW_HELD && (
    <section class="band grey"><div class="wrap"><div class="read">
      {sections.map((t, i) => (
        <>
          <h2>{t}</h2>
          {t === 'Contact'
            ? <p>Questions about this policy: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p>
            : <><p>{LOREM[i % 3]}</p><p>{LOREM[(i + 1) % 3]}</p></>}
        </>
      ))}
    </div></div></section>
  )}
</V2>
