---
// Home, per wireframe home_v02-2 (Site Blueprint "Home", 10 bands, 2 dark).
// Anything only Freeman can answer is a <Held> chip (src/lib/held.ts); see /held for the list.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Work from '../layouts/Work.astro';
import WorkCard from '../components/WorkCard.astro';
import Held from '../components/Held.astro';
import MediaSlot from '../components/MediaSlot.astro';
import CtaBox from '../components/CtaBox.astro';
import { homeCards } from '../data/services';
import { TALK, AUDIT } from '../lib/site';
import hero from '../assets/studio/hero-mountain-ai-bw.webp';
import portrait from '../assets/studio/chris-dunn-portrait-bw.webp';
import Texture from '../components/Texture.astro';

// Featured three in the order drawn: Deeper, Peace Park, GU Energy. Ironwood swap waits on Freeman.
const FEATURED = ['jeremy-jones-deeper', 'peace-park', 'gu-energy'];
const all = await getCollection('work', ({ data }) => !data.draft);
const featured = FEATURED.map((id) => all.find((e) => e.id === id)).filter((e) => e !== undefined);
const clients = ['Teton Gravity Research', 'Brain Farm', 'GU Energy', 'Stio', 'Peace Park', 'Asymbol', 'Ironwood Homes'];
const engage = [
  { name: 'Audit', line: 'A senior review of your brand, site or creative workflow, with a prioritized plan you can act on.', href: AUDIT, held: true },
  { name: 'Sprint', line: 'A defined project with a clear finish line.', href: TALK },
  { name: 'Retainer', line: 'Monthly creative capacity for teams that ship constantly: ads, social, email, decks and web updates.', href: TALK },
];
const lab = [
  { kind: 'Series', title: 'Celtic / triskele' },
  { kind: 'R&D note', title: 'Client Zero: rebuilding our own site with an agent studio' },
  { kind: 'Field guide', title: 'Field guide', guide: true },
];
---
<Work title="Dunn Creative · Brand, web and content studio in Jackson, WY" description="Dunn Creative is a senior-led brand, web and content studio in Jackson, WY, with an AI-accelerated workflow and 20+ years of brand and digital judgment.">
  <!-- 02 · Hero: type on white, the still below. At phone width the still moves above the type. -->
  <section class="band hero">
    <div class="wrap copy">
      <p class="eyebrow">Creative studio · Jackson, WY</p>
      <h1>Brand, web and content. Built sharper, shipped faster.</h1>
      <p class="lede">A senior-led studio with an AI-accelerated workflow. 20+ years of brand and digital judgment, with production that keeps up with your calendar.</p>
      <div class="actions">
        <a class="btn" href={TALK}>Let's talk</a>
        <a class="textcta" href="/work/">See the work +</a>
      </div>
    </div>
    <figure class="wrap reel">
      <div class="media">
        <Image src={hero} alt="A black-and-white mountain ridge under cloud" widths={[720, 1200, 1672]} sizes="(min-width: 1200px) 1104px, 100vw" loading="eager" />
        <span class="ai-label">AI-made image</span>
      </div>
      <figcaption><Held id="hero-reel" note="hero reel or Freeman's photo replaces this still" /></figcaption>
    </figure>
  </section>

  <!-- 03 · Client logo strip -->
  <section class="band grey tight" aria-label="Clients">
    <div class="wrap">
      <ul class="names">{clients.map((c) => <li>{c}</li>)}</ul>
      <Held id="client-logos" block note="client logo files (names shown as type for now)" />
    </div>
  </section>

  <!-- 04 · Featured work -->
  <section class="band">
    <div class="wrap">
      <div class="sec-head"><h2>Recent work</h2></div>
      <div class="grid">{featured.map((e) => <WorkCard entry={e} large />)}</div>
      <div class="actions"><a class="textcta" href="/work/">All work +</a><Held id="ironwood-swap" /></div>
    </div>
  </section>

  <!-- 05 · Services -->
  <section class="band grey" id="services">
    <div class="wrap">
      <div class="sec-head"><h2>What we make</h2></div>
      <div class="cards">
        {homeCards.map((s) => (
          <article class="card-s">
            <h3>{s.name}</h3>
            <ul class="chips">{s.tags.map((t) => <li>{t}</li>)}</ul>
            <a class="textcta more" href={s.href}>Learn more +</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 · AI band (dark, texture allowed) -->
  <section class="band dark aiband">
    <Texture />
    <div class="wrap">
      <div class="two">
        <div>
          <p class="eyebrow">Creative studio</p>
          <h2>We make the work.</h2>
          <p class="lede">Brand, web, content and decks. One senior creative director directs every job, from the first idea to the final file.</p>
        </div>
        <div>
          <p class="eyebrow">AI studio</p>
          <h2>And we build the AI that makes it.</h2>
          <p class="lede">AI drafts, versions and preps. People make the strategy, the direction and the final calls.</p>
        </div>
      </div>
      <div class="actions"><a class="textcta" href="/ai/">How we use AI +</a></div>
    </div>
  </section>

  <!-- 07 · How we engage -->
  <section class="band">
    <div class="wrap">
      <div class="sec-head"><h2>Start small. Scale when it works.</h2></div>
      <div class="cards">
        {engage.map((e) => (
          <article class="card-s">
            <h3>{e.name}</h3>
            <p>{e.line}</p>
            {e.held && <p><Held id="audit-format" /></p>}
            <a class="textcta more" href={e.href}>Learn more +</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 08 · Founder note -->
  <section class="band grey">
    <div class="wrap split">
      <figure class="portrait">
        <Image src={portrait} alt="Chris Dunn, black-and-white portrait" widths={[480, 800]} sizes="(min-width: 880px) 520px, 100vw" />
        <figcaption><Held id="portrait-home" note="portrait pick: default is Chris-Dunn-Portrait-1.jpg" /></figcaption>
      </figure>
      <div>
        <p class="eyebrow">Founder</p>
        <h2>Every project is directed by Chris Dunn.</h2>
        <p class="lede">20+ years in creative direction, brand, web and content, most of it in action sports, film and lifestyle, where the work has to look as good as the footage. Senior creative roles at Teton Gravity Research; film campaign credits on We Are Blood, The Fourth Phase and View From A Blue Moon.</p>
        <div class="actions"><a class="textcta" href="/about/">About the studio +</a></div>
      </div>
    </div>
  </section>

  <!-- 09 · From the Lab -->
  <section class="band">
    <div class="wrap">
      <div class="sec-head"><h2>From the Lab</h2></div>
      <div class="tiles">
        {lab.map((l) => (
          <article class="tile">
            <MediaSlot label="Lab image" />
            <p class="label">{l.kind}</p>
            <h3>{l.guide ? <Held id="lab-guide" /> : l.title}</h3>
            <p class="meta"><Held id="lab-posts" note="date" /></p>
            <a class="textcta" href="/lab/">Read +</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 10 · Final CTA -->
  <CtaBox title="Ready to build something sharper?" button="Let's talk" href={TALK}>
    <p>Tell us what you're building. <Held id="response-time" /></p>
  </CtaBox>
</Work>

<style>
  .hero { padding-top: clamp(48px, 7vw, 104px); padding-bottom: 0; display: flex; flex-direction: column; }
  .hero > .wrap { width: 100%; }
  .hero h1 { max-width: 15ch; }
  .reel { margin-top: clamp(40px, 6vw, 80px); }
  .media { position: relative; overflow: hidden; border-radius: var(--r-tile); background: var(--ink); aspect-ratio: 21 / 9; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 70% 40%; animation: push 14s var(--ease) .3s forwards; }
  @keyframes push { from { transform: scale(1); } to { transform: scale(1.06); } }
  .ai-label { position: absolute; left: 16px; bottom: 16px; background: rgba(11,12,13,.88); color: var(--white); font-size: var(--fs-body); font-weight: 600; padding: 6px 14px; border-radius: var(--r-pill); }
  figcaption { margin-top: 12px; color: var(--caption); }
  @media (max-width: 759px) {
    .hero { padding-top: 24px; }
    .reel { order: -1; margin: 0 0 28px; }
    .media { aspect-ratio: 4 / 5; }
    .media :global(img) { object-position: 72% 50%; }
  }
  .names { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 12px 36px; font-size: var(--fs-card); font-weight: 600; color: var(--ink); }
  .names li { margin: 0; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px 20px; }
  @media (min-width: 720px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1040px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .two { display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; }
  @media (min-width: 880px) { .two { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .two h2 { max-width: 14ch; }
  .portrait { margin: 0; }
  .portrait :global(img) { border-radius: var(--r-tile); width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .portrait figcaption { margin-top: 12px; }
  .meta { margin: 0; }
</style>
