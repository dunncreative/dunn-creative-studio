---
// Home, per wireframe home_v02-2 (10 bands), in the Ridge look Freeman picked on 18 Nov.
// Anything only Freeman can answer is a <Held> chip (src/lib/held.ts); see /held for the list.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Work from '../layouts/Work.astro';
import WorkCard from '../components/WorkCard.astro';
import Held from '../components/Held.astro';
import MediaSlot from '../components/MediaSlot.astro';
import RidgeHero from '../components/RidgeHero.astro';
import RidgeCta from '../components/RidgeCta.astro';
import Texture from '../components/Texture.astro';
import { homeCards } from '../data/services';
import { TALK, AUDIT } from '../lib/site';
import portrait from '../assets/studio/chris-dunn-portrait-bw.webp';
import logoTgr from '../assets/clients/teton-gravity-research.png';
import logoBrainFarm from '../assets/clients/brain-farm.png';
import logoGu from '../assets/clients/gu-energy.png';
import logoStio from '../assets/clients/stio.png';
import logoPeacePark from '../assets/clients/peace-park.png';
import logoAsymbol from '../assets/clients/asymbol.png';
import logoIronwood from '../assets/clients/ironwood-homes.png';
import { labHref } from '../data/lab';

// Featured three: Deeper, Peace Park, Ironwood Homes (Freeman: Ironwood replaces GU Energy).
const FEATURED = ['jeremy-jones-deeper', 'peace-park', 'ironwood-homes'];
const all = await getCollection('work', ({ data }) => !data.draft);
const featured = FEATURED.map((id) => all.find((e) => e.id === id)).filter((e) => e !== undefined);
// Official client logos Freeman supplied on 19 Nov (padding trimmed, art untouched).
// Each is sized to roughly the same visual area, with a cap so square marks don't tower.
const clients = [
  { name: 'Teton Gravity Research', src: logoTgr },
  { name: 'Brain Farm', src: logoBrainFarm, optical: 0.8 }, // heavy wordmark, eased down
  { name: 'GU Energy', src: logoGu },
  { name: 'Stio', src: logoStio },
  { name: 'Peace Park', src: logoPeacePark, optical: 1.35 }, // thin linework, eased up
  { name: 'Asymbol', src: logoAsymbol },
  { name: 'Ironwood Homes', src: logoIronwood },
].map((c: { name: string; src: ImageMetadata; optical?: number }) => {
  const aspect = c.src.width / c.src.height;
  const optical = c.optical ?? 1;
  const h = Math.round(Math.min(52 * Math.sqrt(optical), (Math.sqrt((4400 * optical) / aspect))));
  return { ...c, h, w: Math.round(h * aspect) };
});
const engage = [
  { name: 'Audit', line: 'Start with a free audit: a short written review of your site with the top fixes, within 5 business days. Or book a call, or go deeper with the advanced audit.', credit: true, href: AUDIT },
  { name: 'Sprint', line: 'A defined project with a clear finish line.', href: TALK },
  { name: 'Retainer', line: 'Monthly creative capacity for teams that ship constantly: ads, social, email, decks and web updates.', href: TALK },
];
const lab = [
  { kind: 'Series', title: 'Celtic / triskele', href: labHref('celtic-triskele') },
  { kind: 'R&D note', title: 'Client Zero: rebuilding our own site with an agent studio', href: labHref('client-zero') },
  { kind: 'Field guide', title: 'Field guide', guide: true, href: labHref('field-guide') },
];
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<Work title="Dunn Creative · Brand, web and content studio in Jackson, WY" description="Dunn Creative is a senior-led brand, web and content studio in Jackson, WY, with an AI-accelerated workflow and 20+ years of brand and digital judgment.">
  <!-- 02 · Hero -->
  <RidgeHero
    label="Creative studio · Jackson, WY"
    title="Brand, web and content. Built sharper, shipped faster."
    stand="A senior-led studio with an AI-accelerated workflow. 20+ years of brand and digital judgment, with production that keeps up with your calendar."
    meta={['Brand', 'Web', 'Content', 'Decks', 'AI for creative teams']}
  >
    <div class="ctas">
      <a class="btn" href={TALK}>Let's talk</a>
      <a class="textcta" href="/work/">See the work +</a>
    </div>
    <p class="cap" style="margin-top:22px"><Held id="hero-reel" note="hero reel or Freeman's photo can sit behind the ridge" /></p>
  </RidgeHero>

  <!-- 03 · Client names -->
  <section class="proof" aria-label="Clients">
    <div class="wrap">
      <span class="lbl">Brands we've built work for</span>
      <ul class="logos">
        {clients.map((c) => (
          <li><Image src={c.src} alt={c.name} width={c.w} height={c.h} densities={[1, 2]} loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 04 · Featured work -->
  <section class="band" id="work">
    <div class="wrap">
      <div class="sechead"><h2>Recent work</h2><a class="textcta" href="/work/">All work +</a></div>
      <div class="tiles">{featured.map((e) => <WorkCard entry={e} />)}</div>
    </div>
  </section>

  <!-- 05 · Services -->
  <section class="band grey" id="services">
    <div class="wrap">
      <div class="sechead"><h2>What we make</h2><a class="textcta" href="/services/">All services +</a></div>
      <div class="index">
        {homeCards.map((s, i) => (
          <a href={s.href}>
            <span class="n">{n(i)}</span>
            <h3>{s.name}</h3>
            <p>{s.line}</p>
            <ul class="tags">{s.tags.map((t) => <li>{t}</li>)}</ul>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 · AI band (dark, texture allowed) -->
  <section class="band dark">
    <Texture />
    <div class="wrap">
      <div class="split" style="margin-bottom:56px">
        <div><p class="lbl">Creative studio</p><h2 style="margin-top:12px">We make the work.</h2></div>
        <div><p class="lbl">AI studio</p><h2 style="margin-top:12px;color:#9a9da1">And we build the AI that makes it.</h2></div>
      </div>
      <div class="three">
        <div><p class="lbl">01</p><h3>One senior director</h3><p>One senior creative director directs every job, from the first idea to the final file.</p></div>
        <div><p class="lbl">02</p><h3>Agent studio</h3><p>AI drafts, versions and preps. People make the strategy, the direction and the final calls.</p></div>
        <div><p class="lbl">03</p><h3>Production tools</h3><p>Production that keeps up with your calendar.</p></div>
      </div>
      <div class="ctas" style="margin-top:44px"><a class="textcta" href="/ai/">How we use AI +</a></div>
    </div>
  </section>

  <!-- 07 · How we engage -->
  <section class="band">
    <div class="wrap">
      <div class="sechead"><h2>Start small. Scale when it works.</h2></div>
      <div class="steps c3">
        {engage.map((e, i) => (
          <div>
            <span class="n">{n(i)}</span>
            <h3>{e.name}</h3>
            <p>{e.line} {e.credit && <Held id="audit-credit" />}</p>
            <a class="textcta" href={e.href}>Learn more +</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 08 · Founder note -->
  <section class="band grey">
    <div class="wrap split">
      <figure class="portrait">
        <Image src={portrait} alt="Chris Dunn, black-and-white portrait" widths={[480, 800]} sizes="(min-width: 880px) 480px, 100vw" />
      </figure>
      <div>
        <p class="lbl">Founder</p>
        <h2 style="margin:14px 0 22px">Every project is directed by Chris Dunn.</h2>
        <p class="stand">20+ years in creative direction, brand, web and content, most of it in action sports, film and lifestyle, where the work has to look as good as the footage. Senior creative roles at Teton Gravity Research; film campaign credits on We Are Blood, The Fourth Phase and View From A Blue Moon.</p>
        <div class="ctas" style="margin-top:24px"><a class="textcta" href="/about/">About the studio +</a></div>
      </div>
    </div>
  </section>

  <!-- 09 · From the Lab -->
  <section class="band" id="lab">
    <div class="wrap">
      <div class="sechead"><h2>From the Lab</h2><a class="textcta" href="/lab/">The Lab +</a></div>
      <div class="tiles">
        {lab.map((l) => (
          <article class="tile">
            <MediaSlot label="Lab image" ratio="1 / 1" />
            <p class="lbl">{l.kind}</p>
            <h3>{l.guide ? <Held id="lab-guide" /> : l.title}</h3>
            <p class="cap"><Held id="lab-posts" note="date" /></p>
            <a class="textcta" href={l.href}>Read +</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 10 · Final CTA -->
  <RidgeCta title="Ready to build something sharper?" button="Let's talk" href={TALK} id="talk">
    <p class="stand">Tell us what you're building.</p>
    <Held id="response-time" />
  </RidgeCta>
</Work>
