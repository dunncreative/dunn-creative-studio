---
// AI statement (footer link), on the V2 layout and footer (v04 · 10 QA).
// No approved statement copy exists yet (held: ai-statement-copy). The live site (CONTEXT=production) shows one
// neutral holding line; Deploy Previews keep the draft structure (real section titles, the draft lines and
// lorem ipsum) so the shape can be reviewed. Nothing here is a commitment until Freeman approves the text.
import V2 from '../layouts/V2.astro';
import Held from '../components/Held.astro';
import { LOREM } from '../lib/lorem';
import { SHOW_HELD } from '../lib/held';
import { TALK } from '../lib/site';
const sections = [
  ['What AI does here', 'AI drafts, versions and preps.'],
  ['What people do', 'People make the strategy, the direction and the final calls.'],
  ['Disclosure', 'We tell you what’s AI-assisted, every time.'],
  ['Your files and data', ''],
  ['Ownership', ''],
  ['Tools we use', 'We pick for your workflow: ChatGPT, Claude, Midjourney, Adobe Firefly, Runway and others. For client imagery we use commercially safe models only.'],
];
---
<V2 title="AI statement · Dunn Creative" description="How Dunn Creative uses AI.">
  <section class="lhero"><div class="wrap">
    <p class="lbl">AI statement</p>
    <h1>AI statement</h1>
    <div class="lh2">
      {SHOW_HELD
        ? <p class="stand">Draft structure only (preview). <Held id="ai-statement-copy" /></p>
        : <p class="stand">Our AI statement is being finalized. Ask us anything on the <a href={TALK}>contact page</a>.</p>}
      <div class="ctas"><a class="tlink" href="/ai/">How we use AI +</a></div>
    </div>
  </div></section>
  {SHOW_HELD && (
    <section class="band grey"><div class="wrap"><div class="read">
      {sections.map(([t, line], i) => (
        <>
          <p class="lbl" style="margin-top:48px">{String(i + 1).padStart(2, '0')}</p>
          <h2 style="margin-top:8px">{t}</h2>
          {line && <p><b>{line}</b></p>}
          <p>{LOREM[i % 3]}</p>
        </>
      ))}
      <p style="margin-top:32px"><Held id="ownership" /></p>
    </div></div></section>
  )}
</V2>
