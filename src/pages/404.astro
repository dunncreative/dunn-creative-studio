---
// 404 on the V2 layout and footer (v04 · 10 QA: no old SiteFooter, so no /explore or /held links).
import V2 from '../layouts/V2.astro';
import { TALK } from '../lib/site';
---
<V2 title="Page not found · Dunn Creative" description="This page doesn't exist.">
  <section class="lhero"><div class="wrap">
    <p class="lbl">404</p>
    <h1>This page doesn't exist.</h1>
    <div class="lh2">
      <p class="stand">The link may be old or mistyped. Start from one of these.</p>
      <div class="ctas"><a class="tlink" href="/">Home +</a><a class="tlink" href="/work/">See the work +</a><a class="btn" href={TALK}>Let's talk</a></div>
    </div>
  </div></section>
</V2>
