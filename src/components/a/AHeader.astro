---
// Direction A header: light nav, logo black on light, "Let's talk" always visible. At 760px and below the links
// fold into a "Menu" <details> (README page system, rule 6: classes ahdr, anav, amenu, acta).
import { NAV, TALK } from '../../lib/site';
const path = Astro.url.pathname;
const current = (href: string) => (path === href || path.startsWith(href) ? 'page' : undefined);
---
<header class="ahdr"><div class="a-wrap">
  <a class="a-logo" href="/" aria-label="Dunn Creative home"><img src="/v2/assets/dunn-creative-logo-black.png" alt="Dunn Creative" width="63" height="30" /></a>
  <nav aria-label="Main"><ul class="anav">{NAV.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}</ul></nav>
  <details class="amenu"><summary>Menu</summary><div class="a-menu-panel">
    {NAV.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
  </div></details>
  <a class="acta" href={TALK}>Let’s talk</a>
</div></header>
