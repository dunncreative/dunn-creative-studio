---
// A placeholder for something only Freeman can answer. See src/lib/held.ts.
// Shows the answer once it is set there; until then a dashed "Held" chip (preview only).
// block: the chip sits on its own line instead of inline with text.
import { held, SHOW_HELD, type HeldId } from '../lib/held';
interface Props { id: HeldId; block?: boolean; note?: string }
const { id, block = false, note } = Astro.props;
const item = held[id];
const answer = 'answer' in item ? (item as { answer?: string }).answer : undefined;
---
{answer ? (
  <Fragment set:text={answer} />
) : SHOW_HELD ? (
  <a class:list={['held', { block }]} href={`/held/#${id}`} data-held={id} title={item.ask}>
    <span class="tag">Held</span><span class="txt">{note ?? item.label}</span>
  </a>
) : null}

<style>
  .held {
    display: inline-flex; align-items: baseline; gap: 6px; vertical-align: baseline;
    padding: 2px 10px; margin: 0 2px; border: 1.5px dashed currentColor; border-radius: 6px;
    font-size: 13px; font-weight: 600; line-height: 1.5; letter-spacing: 0; text-transform: none;
    color: var(--dark-grey); background: transparent; text-decoration: none; white-space: normal;
  }
  .held.block { display: flex; width: fit-content; max-width: 100%; margin: 12px 0 0; }
  .held:hover { color: var(--ink); }
  .tag { font-weight: 700; }
  :global(.band.dark) .held { color: var(--grey-200); }
  :global(.band.dark) .held:hover { color: var(--white); }
</style>
