---
// Global header, per Client Zero low-fi wireframe v02 (Blueprint Home band 01):
// logo left (black on light), nav links right. Per Moodboard v02.2 the nav "Let's talk" is always an
// Ink outline pill, so the hero's button stays the only solid one in the first screen.
// (The cta prop is kept so existing callers still compile; it no longer changes the look.)
// Nav dark vs light is still an open decision in Brand Guidelines v1; this is the light preview.
// theme: light for now (Freeman, 18 Nov). theme="dark" gives an Ink bar with the White logo, for pages
// that should switch later; set per page through the layout's nav prop or site-wide with NAV_THEME.
interface Props { cta?: 'solid' | 'ghost'; theme?: 'light' | 'dark' }
const { theme = 'light' } = Astro.props;
import { NAV, TALK } from '../lib/site';
const path = Astro.url.pathname;
// Every page in the v02.1 wireframes is built, so all five links are live.
const links: { label: string; href?: string }[] = NAV;
const talk = TALK;
---
<header class:list={['gh', theme]}>
  <div class="wrap gh-row">
    <a class="gh-logo" href="/" aria-label="Dunn Creative, home">
      <img src={theme === 'dark' ? '/brand/dunn-creative-logo-white.png' : '/brand/dunn-creative-logo-black.png'} alt="Dunn Creative" width="968" height="461" />
    </a>
    <nav class="gh-nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            {l.href
              ? <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
              : <span title="Page coming soon">{l.label}</span>}
          </li>
        ))}
      </ul>
      <a class="gh-cta ghost" href={talk}>Let's talk</a>
    </nav>
    <details class="gh-menu">
      <summary>Menu <span aria-hidden="true">≡</span></summary>
      <div class="gh-panel">
        <ul>
          {links.map((l) => (
            <li>
              {l.href
                ? <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
                : <span>{l.label} <small>soon</small></span>}
            </li>
          ))}
        </ul>
        <a class="gh-cta ghost" href={talk}>Let's talk</a>
      </div>
    </details>
  </div>
</header>

<style>
  .gh { position: relative; z-index: 20; background: var(--white); border-bottom: 1px solid var(--grey-200); }
  .gh-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 68px; }
  .gh-logo { display: block; flex: none; line-height: 0; }
  .gh-logo img { height: 40px; width: auto; }
  .gh a, .gh span { color: var(--ink); text-decoration: none; }

  .gh-nav { display: none; align-items: center; gap: 32px; }
  .gh-nav ul { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; font-size: var(--fs-body); }
  .gh-nav li { margin: 0; }
  .gh-nav li + li::before { content: '·'; color: var(--dark-grey); padding: 0 10px; }
  .gh-nav a:hover, .gh-nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1.5px; }
  .gh-nav span { cursor: default; }

  .gh-cta { white-space: nowrap; }
  .gh .gh-cta.ghost:hover { color: var(--white); }

  .gh-menu { position: static; }
  .gh-menu summary { list-style: none; cursor: pointer; font-weight: 600; font-size: 17px; color: var(--ink); padding: 8px 0; }
  .gh-menu summary::-webkit-details-marker { display: none; }
  .gh-menu summary span { font-size: 20px; margin-left: 2px; }
  .gh-panel { position: absolute; left: 0; right: 0; top: 100%; background: var(--white); border-bottom: 1px solid var(--grey-200); padding: 8px 16px 24px; box-shadow: 0 12px 24px rgba(0,0,0,.06); }
  .gh-panel ul { list-style: none; margin: 0 0 16px; padding: 0; }
  .gh-panel li { margin: 0; border-bottom: 1px solid var(--grey-200); }
  .gh-panel li a, .gh-panel li span { display: block; padding: 14px 0; font-size: var(--fs-card); font-weight: 600; }
  .gh-panel li span { color: var(--dark-grey); }
  .gh-panel small { font-size: var(--fs-body); font-weight: 400; margin-left: 6px; }

  .gh-panel { padding-inline: var(--gutter); }
  /* Dark nav (switch, not used yet): Ink bar, White logo and links, White outline button. */
  .gh.dark { background: var(--ink); border-bottom-color: #1e1f21; }
  .gh.dark a, .gh.dark span, .gh.dark .gh-menu summary { color: var(--white); }
  .gh.dark .gh-cta.ghost { box-shadow: inset 0 0 0 1.5px var(--white); }
  .gh.dark .gh-cta.ghost:hover { background: var(--white); color: var(--ink); }
  .gh.dark .gh-panel { background: var(--ink); border-bottom-color: #1e1f21; }
  .gh.dark .gh-panel li { border-bottom-color: #1e1f21; }
  @media (min-width: 880px) {
    .gh-row { height: 88px; }
    .gh-logo img { height: 48px; }
    .gh-nav { display: flex; }
    .gh-menu { display: none; }
  }
</style>
