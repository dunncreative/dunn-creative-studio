---
import { clean } from '../lib/placeholders';
// One work image. When `mobile` is set, the desktop and phone screenshots of the
// same page sit side by side at equal height (columns sized by their aspect ratios).
interface Props {
  image: { src: string; alt: string; caption?: string; ground?: 'light' | 'grey' | 'dark'; mobile?: string };
  ground?: 'light' | 'grey' | 'dark';
  lazy?: boolean;
  class?: string;
}
const { image, ground, lazy = false, class: cls } = Astro.props;
const loading = lazy ? 'lazy' : undefined;
const caption = clean(image.caption);
---
{image.mobile ? (
  <figure class:list={['shots', cls]}>
    <div class="pair">
      <img class="desk" src={image.src} alt={`${image.alt} on desktop`} width="1440" height="900" loading={loading} decoding="async" />
      <img class="phone" src={image.mobile} alt={`${image.alt} on a phone`} width="485" height="844" loading={loading} decoding="async" />
    </div>
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
) : (
  <figure class={cls} data-ground={image.ground ?? ground}>
    <img src={image.src} alt={image.alt} loading={loading} decoding="async" />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
)}
<style>
  figure { margin: 0; }
  figure.wrap { margin-inline: auto; }
  figure > img { border-radius: var(--r-tile); margin: 0 auto; max-height: 80vh; width: auto; }
  figure[data-ground="grey"] > img { background: var(--grey-50); padding: 32px; }
  figure[data-ground="dark"] > img { background: var(--ink); }
  figcaption { margin-top: 12px; color: var(--caption); text-align: center; }
  :global(.band.dark) figcaption { color: var(--grey-500); }
  .pair { display: grid; gap: 24px; align-items: start; }
  .pair img { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--grey-200); background: var(--white); }
  .pair .phone { max-width: 280px; margin: 0 auto; }
  @media (min-width: 720px) {
    /* 1440/900 = 1.6 and 485/844 ≈ 0.575, so both images come out the same height. */
    .pair { grid-template-columns: 1.6fr 0.575fr; }
    .pair .phone { max-width: none; }
  }
</style>
