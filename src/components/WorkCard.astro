---
import type { CollectionEntry } from 'astro:content';
import { isAiImage } from '../lib/placeholders';
interface Props { entry: CollectionEntry<'work'>; large?: boolean }
const { entry, large = false } = Astro.props;
const d = entry.data;
const img = d.images[0];
const isCase = d.kind === 'case-study';
const href = `/work/${entry.id}/`;
---
<article class:list={['card', { large }]} data-kind={d.kind} data-disc={d.disciplines.join('|')}>
  <a href={href} class="media" data-ground={img?.ground ?? 'grey'} aria-label={`${d.title}: ${isCase ? 'case study' : 'snapshot'}`}>
    {img && <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />}
  </a>
  <p class="label">{isCase ? 'Case study' : 'Snapshot'} · {d.disciplines.join(' · ')}</p>
  {isAiImage(img?.caption) && <p class="ainote">Image: AI-directed mockup</p>}
  <h3><a href={href}>{d.title}</a></h3>
  {d.client !== d.title && <p class="client">{d.client}</p>}
  {isCase && <a class="textcta" href={href}>View +</a>}
</article>
<style>
  .card { display:flex; flex-direction:column; gap: 6px; }
  .card h3 a { color: var(--ink); text-decoration: none; }
  .client { margin: 0; color: var(--grey-500); font-size: 15px; }
  .label { margin: 10px 0 0; }
  .media { display:flex; align-items:center; justify-content:center; aspect-ratio: 4 / 3; border-radius: 20px; overflow:hidden; background: var(--grey-50); }
  .media[data-ground="dark"] { background: var(--ink); }
  .media[data-ground="light"] { background: var(--white); outline: 1px solid var(--grey-200); }
  .media img { width:100%; height:100%; object-fit: contain; }
  .large .media { aspect-ratio: 16 / 10; }
  .textcta { font-size: 15px; }
  .ainote { margin: 0; font-size: 13px; color: #333333; }
</style>
