---
// Ridge work tile: a 22px-cornered image, a caption label, a medium title and the one-line summary.
// The whole tile is the link. Logos (images with a set ground) sit contained on their ground;
// website screenshots crop from the top; everything else fills the tile.
import type { CollectionEntry } from 'astro:content';
import { isAiImage } from '../lib/placeholders';
interface Props { entry: CollectionEntry<'work'>; large?: boolean; feature?: boolean }
const { entry, feature = false } = Astro.props;
const d = entry.data;
const img = feature ? (d.cardImage ?? d.images[0]) : d.images[0];
const isCase = d.kind === 'case-study';
const href = `/work/${entry.id}/`;
const disc = d.disciplines.join(' · ');
const fit = img?.ground ? (d.disciplines.includes('Branding') ? 'logo' : 'box') : d.disciplines.includes('Websites') ? 'shot' : 'fill';
---
<a class:list={['wcard', { feat: feature }]} href={href} data-kind={d.kind} data-disc={d.disciplines.join('|')}>
  <div class:list={['wimg', fit, img?.ground && `g-${img.ground}`]}>
    {img && <img src={img.src} alt={img.alt} loading={feature ? 'eager' : 'lazy'} decoding="async" />}
    {isAiImage(img?.caption) && <span class="ai-pill">AI-directed mockup</span>}
  </div>
  <p class="lbl">{isCase ? `${d.client} · ${disc}` : `Snapshot · ${disc}`}</p>
  <h3>{d.title}</h3>
  <p class="sum">{d.summary}</p>
  {feature && isCase && <span class="textcta">Read the case study +</span>}
</a>
<style>
  .wcard { display: block; min-width: 0; text-decoration: none; color: inherit; }
  .wcard:hover h3 { color: var(--teal-deep); }
  .wcard:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; border-radius: var(--r-tile); }
  .wimg { position: relative; border-radius: var(--r-tile); overflow: hidden; aspect-ratio: 4 / 3; background: var(--grey-50); transition: transform .2s var(--ease); }
  .wcard:hover .wimg { transform: translateY(-2px); }
  .wimg img { width: 100%; height: 100%; object-fit: cover; }
  .wimg.shot img { object-position: 50% 0; }
  .wimg.g-dark { background: var(--ink); }
  .wimg.logo img { object-fit: contain; padding: 12%; }
  .wimg.box img { object-fit: contain; padding: 8%; }
  :global(.band.grey) .wimg.g-grey, :global(.band.grey) .wimg.g-light { background: var(--white); }
  .lbl { margin-top: 16px; }
  h3 { font-size: 20px; font-weight: 500; margin: 4px 0 6px; transition: color .15s; }
  .sum { color: var(--stand); font-size: 16px; margin: 0; }
  .textcta { display: inline-block; margin-top: 12px; color: var(--teal-deep); }
  .feat .wimg { aspect-ratio: 21 / 9; }
  @media (min-width: 1100px) { :global(.wgrid.c5) h3 { font-size: 17px; } :global(.wgrid.c5) .sum { font-size: 14px; } }
  @media (max-width: 560px) { .feat .wimg { aspect-ratio: 4 / 3; } }
</style>
