---
// Site footer for the v2 pages. The line "Real results" stays as written until Freeman changes it (held: footer-line).
import { SERVICE_AREAS, TALK, PLACE } from '../../lib/site';
const studio = [
  { label: 'Work', href: '/work/' },
  { label: 'Sprints', href: '/sprints/' },
  { label: 'Lab', href: '/lab/' },
  { label: 'About', href: '/about/' },
];
---
<footer class="foot"><div class="wrap">
  <div class="grid">
    <div>
      <img src="/v2/assets/dunn-creative-logo-black.png" alt="Dunn Creative" width="84" height="40" />
      <p>Strategic thinking. Clean design. Real results.</p>
      <p class="cap">Creative studio · {PLACE}</p>
    </div>
    <div><h4>Services</h4><ul>{SERVICE_AREAS.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul></div>
    <div><h4>Studio</h4><ul>{studio.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul></div>
    <div><h4>Contact</h4><ul><li><a href={TALK}>Let's talk</a></li><li><a href="/ai-statement/">AI statement</a></li><li><a href="/privacy/">Privacy</a></li></ul></div>
  </div>
  <div class="base"><span>© 2026 Dunn Creative</span><span>Creative studio · {PLACE}</span></div>
</div></footer>
